<Project>
  <!--
    Avalonia's stats task writes a telemetry log to %LOCALAPPDATA%\AvaloniaUI\BuildServices\buildtasks.log,
    which the sandbox denies. The task runs only when UsedAvaloniaProducts is non-empty, so clear it here:
    Directory.Build.targets is evaluated after the Avalonia package props that set the property.
  -->
  <PropertyGroup>
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>

  <!--
    M1-T4 publishing pipeline. Opt-in projects (IsPackable=true, set in their own csproj) get:
      * XML documentation next to the assembly (asserted by tools/check-package.ps1);
      * the repository LICENSE, README and third-party notices packed at the package root.
    XML-doc completeness warnings that predate the M2 documentation sweep are suppressed; CS1591
    (missing summary) is already in Directory.Build.props.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1572;CS1573;CS1574;CS1584;CS1587;CS1658;CS1711;CS1712</NoWarn>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
