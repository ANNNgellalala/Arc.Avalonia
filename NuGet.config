<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- This machine has no working nuget.org access. Every package this solution needs is
       already in the global packages folder, so restore runs fully offline.

       Arc.Avalonia.Markdown consumes the PuraMarkdown syntax layer (Markdig-based, no Avalonia)
       as a published package. The sibling checkout supplies the local feed; see
       docs/21-markdown-components.zh.md for the one-time `dotnet pack` step. -->
  <packageSources>
    <clear />
    <add key="puramarkdown-local" value="..\PuraMarkdown\artifacts\nuget" />
  </packageSources>
</configuration>
