+    /// <summary>The archive button sits under the row surface as the item template grid's other child.</summary>
+    private static Button? FindArchiveAction(Border row)
+    {
+        if (row.Parent is not Grid grid)
+        {
+            return null;
+        }
+
+        foreach (var child in grid.Children)
+        {
+            if (child is Button button && button.Classes.Contains("archive-action"))
+            {
+                return button;
+            }
+        }
+
+        return null;
+    }
+
     private sealed class RowSwipeState
     {
         public TranslateTransform Transform { get; } = new();
 
         public bool Open { get; set; }
+
+        /// <summary>The action painted underneath the row surface, visible only while dragged or open.</summary>
+        public Button? Action { get; set; }
+
+        /// <summary>
+        /// A closed row must not paint its action at all. The row card's rounded, antialiased edge and its
+        /// 1px translucent border do not fully cover what sits underneath, so an always-painted danger
+        /// button leaks a red hairline along the right edge and corners -> the action is toggled instead
+        /// of being relied on the card to hide it.
+        /// </summary>
+        public void SetActionPainted(bool painted)
+        {
+            if (Action is null)
+            {
+                return;
+            }
+
+            Action.Opacity = painted ? 1 : 0;
+            // A hidden action must not keep taking tab focus or hit tests either.
+            Action.IsTabStop = painted;
+            Action.IsHitTestVisible = painted;
+        }
     }
 }
