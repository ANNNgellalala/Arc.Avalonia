<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia's stats build task writes a telemetry log outside the workspace; disable it. -->
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
    <NoWarn>$(NoWarn);NU1900;NU1901;NU1902;NU1903;NU1904;CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
