<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Chat">

  <!--
    Chat family theme. Chat rendering (messages, markdown, pura-agent components, streaming) now belongs to
    PuraMarkdown.Agent (ADR 0007); Arc only themes the composer input surface.
  -->
  <ControlTheme x:Key="{x:Type c:ArcChatComposer}" TargetType="c:ArcChatComposer">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="PART_Host" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
