<Project Sdk="Microsoft.NET.Sdk">
    <!--
    L2 Chat family (ADR 0007): the chat surface is a thin Arc wrapper over PuraMarkdown.Agent's
    PuraChatView/PuraChatMessage (Markdown, pura-agent components and streaming all live upstream);
    Arc supplies the token-derived theme mapping (ArcChatThemeAdapter) and the composer input surface.
  -->
  <PropertyGroup>
    <RootNamespace>Arc.Avalonia.Chat</RootNamespace>
    <AssemblyName>Arc.Avalonia.Chat</AssemblyName>
    <PackageId>Arc.Avalonia.Chat</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Chat family for Arc for Avalonia: unified message model, bubble conversation surface, composer, streaming and virtualization. Used by human chat, AI answers and the agent conversation layer.</Description>
    <PackageTags>avalonia;chat;ai;agent;streaming;design-system</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="PuraMarkdown.Agent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Foundation\Arc.Avalonia\Arc.Avalonia.csproj" />
    <ProjectReference Include="..\Arc.Avalonia.Services\Arc.Avalonia.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arc.Avalonia.Docs" />
    <InternalsVisibleTo Include="Arc.Avalonia.Verify" />
    <InternalsVisibleTo Include="Arc.Avalonia.Tests" />
    <InternalsVisibleTo Include="Arc.Avalonia.Agent" />
    <InternalsVisibleTo Include="Arc.Avalonia.AgentUI" />
  </ItemGroup>
</Project>



