<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:aa="using:Arc.Avalonia.Actions.Controls"
                    xmlns:c="using:Arc.Avalonia.Controls">

  <ControlTheme x:Key="{x:Type aa:ArcUserMenu}" TargetType="aa:ArcUserMenu">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False" Background="Transparent">
          <!-- The avatar trigger: 40px tall, pill, colour-only hover and press. -->
          <c:ArcButton x:Name="PART_Trigger"
                       Variant="Ghost"
                       Size="Sm"
                       Height="40"
                       MinHeight="40"
                       Padding="4"
                       CornerRadius="{DynamicResource ArcRadiusPill}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       HorizontalContentAlignment="Left"
                       VerticalContentAlignment="Center"
                       Classes="user-menu-trigger">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Grid x:Name="Face" Width="32" Height="32" VerticalAlignment="Center">
                <Border x:Name="Portrait" Classes="user-menu-portrait" />
                <TextBlock x:Name="PART_Initials" Classes="user-menu-initials"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border x:Name="PART_Presence" Classes="user-menu-presence"
                        Width="11" Height="11" CornerRadius="{DynamicResource ArcRadiusPill}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="False">
                  <Grid>
                    <Border x:Name="PART_PresenceBar" Classes="user-menu-presence-bar"
                            Width="6" Height="2" CornerRadius="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
                    <Border x:Name="PART_PresenceHole" Classes="user-menu-presence-hole"
                            Width="4" Height="4" CornerRadius="{DynamicResource ArcRadiusPill}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
                  </Grid>
                </Border>
              </Grid>
              <TextBlock x:Name="PART_TriggerName" Classes="user-menu-trigger-name"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="False" />
              <c:ArcIcon x:Name="PART_Chevron" Icon="chevron-down" Size="15"
                         Classes="user-menu-chevron" VerticalAlignment="Center" IsVisible="False" />
            </StackPanel>
          </c:ArcButton>

          <!-- The panel is hosted in the page, so it renders in screenshots without a popup window. -->
          <Canvas x:Name="PART_Overlay" ClipToBounds="False">
            <Border x:Name="PART_Panel"
                    Width="248"
                    IsVisible="False"
                    Background="{DynamicResource ArcSurfaceRaised}"
                    BorderBrush="{DynamicResource ArcBorder}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ArcRadiusPanel}"
                    BoxShadow="{DynamicResource ArcShadowFloating}"
                    Padding="8"
                    ClipToBounds="False"
                    RenderTransformOrigin="1,0">
              <StackPanel Spacing="0">
                <Grid x:Name="Header" ColumnDefinitions="Auto,*">
                  <Grid Width="34" Height="34" VerticalAlignment="Center">
                    <Border x:Name="PanelPortrait" Classes="user-menu-portrait" />
                    <TextBlock x:Name="PART_PanelInitials" Classes="user-menu-initials"
                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock x:Name="PART_NameText" Classes="user-menu-name"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Border x:Name="PART_PlanBadge" Classes="user-menu-plan" IsVisible="False" MaxWidth="96" VerticalAlignment="Center">
                        <TextBlock x:Name="PART_PlanText" Classes="user-menu-plan-text" TextTrimming="CharacterEllipsis" />
                      </Border>
                    </StackPanel>
                    <TextBlock x:Name="PART_EmailText" Classes="user-menu-email" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>

                <Border x:Name="HeaderSeparator" Classes="user-menu-separator" />

                <Panel x:Name="ListHost" Margin="0,0,0,2">
                  <Canvas x:Name="PART_HighlightLayer" ClipToBounds="False" IsHitTestVisible="False">
                    <aa:ArcAdvancedGlide x:Name="PART_Highlight" CornerRadius="18" />
                  </Canvas>
                  <StackPanel x:Name="PART_StopsHost" Spacing="0" Background="Transparent" />
                </Panel>
              </StackPanel>
            </Border>
          </Canvas>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
