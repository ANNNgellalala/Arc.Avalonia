<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="using:Arc.Avalonia.Actions.Controls"
                    xmlns:c="using:Arc.Avalonia.Controls">

<!-- ============================ Accordion ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcAccordion}" TargetType="a:ArcAccordion">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel x:Name="PART_Rows" HorizontalAlignment="Stretch" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

<!-- ============================ Expandable text ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcExpandableText}" TargetType="a:ArcExpandableText">
    <Setter Property="Background" Value="{DynamicResource ArcBackground}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MaxWidth" Value="640" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="6" HorizontalAlignment="Stretch">
          <Border x:Name="PART_Clip"
                  HorizontalAlignment="Stretch"
                  ClipToBounds="True">
            <Panel>
              <TextBlock x:Name="PART_Body"
                         TextWrapping="Wrap"
                         LineHeight="20"
                         Classes="arc-body-sm" />
              <Border x:Name="PART_Fade"
                      Height="26"
                      VerticalAlignment="Bottom"
                      IsHitTestVisible="False" />
            </Panel>
          </Border>
          <c:ArcButton x:Name="PART_Toggle"
                     Variant="Ghost"
                     Size="Sm"
                     MinHeight="28"
                     Padding="0"
                     HorizontalAlignment="Left"
                     HorizontalContentAlignment="Left" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
