<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="using:Arc.Avalonia.Actions.Controls"
        xmlns:i="using:Arc.Avalonia.Internal"
        xmlns:c="using:Arc.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcActions.Buttons.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcActions.Menus.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcActions.Messages.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcActions.Disclosure.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcActionButton.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcExpandingButtonGroup.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcFloatingButtonGroup.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcIconMorph.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcUserMenu.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ============================ Shared highlight ============================ -->
  <Style Selector="i|ArcGlide.arc-glide">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="i|ArcGlide.arc-glide.danger">
    <Setter Property="Background" Value="{DynamicResource ArcDangerSubtle}" />
  </Style>
  <Style Selector="i|ArcGlide.arc-glide.pill">
    <Setter Property="Background" Value="{DynamicResource ArcSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ============================ Menu rows ============================ -->
  <Style Selector="Border.arc-menu-separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="Background" Value="{DynamicResource ArcBorderSubtle}" />
  </Style>

  <Style Selector="c|ArcButton.menu-row">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.menu-row:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.menu-row:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.menu-row.destructive">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcButton.menu-row.destructive:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcButton.menu-row /template/ ContentPresenter#Content">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="c|ArcButton.menu-row /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ============================ Button group ============================ -->
  <Style Selector="c|ArcButton.group-segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="c|ArcButton.group-segment:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.group-segment:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.group-segment.solid">
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentForeground}" />
  </Style>
  <Style Selector="c|ArcButton.group-segment.solid:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentForeground}" />
  </Style>
  <Style Selector="c|ArcButton.group-segment.solid:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.group-segment /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|ArcIcon.group-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.group-segment.solid c|ArcIcon">
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentForeground}" />
  </Style>

  <Style Selector="Border.group-divider">
    <Setter Property="Background" Value="{DynamicResource ArcBorderSubtle}" />
  </Style>
  <Style Selector="Border.group-divider.solid">
    <Setter Property="Background" Value="{DynamicResource ArcAccentForeground}" />
    <Setter Property="Opacity" Value="0.28" />
  </Style>

  <!-- ============================ Split button ============================ -->
  <Style Selector="Border.split-divider">
    <Setter Property="Background" Value="{DynamicResource ArcBorderStrong}" />
  </Style>
  <Style Selector="Border.split-divider.primary">
    <Setter Property="Background" Value="{DynamicResource ArcAccentForeground}" />
    <Setter Property="Opacity" Value="0.32" />
  </Style>

  <!-- ============================ Action swap ============================ -->
  <Style Selector="c|ArcButton.action-swap">
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPill}" />
    <Setter Property="Padding" Value="18,0" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-success">
    <Setter Property="Background" Value="{DynamicResource ArcSuccess}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcBackground}" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-success:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcBackground}" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-success:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcSuccess}" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-warning">
    <Setter Property="Background" Value="{DynamicResource ArcWarning}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcBackground}" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-warning:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcBackground}" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-warning:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcWarning}" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-quiet">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>

  <!-- ============================ Confirm morph ============================ -->
  <Style Selector="a|ArcConfirmMorph c|ArcButton.confirm-answer">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="c|ArcIcon.confirm-done-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" />
  </Style>
  <Style Selector="c|ArcIcon.confirm-error-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcIcon.dropdown-chevron">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>

  <!-- ============================ Accordion ============================ -->
  <Style Selector="c|ArcButton.accordion-header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="c|ArcButton.accordion-header:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.accordion-header /template/ ContentPresenter#Content">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="c|ArcButton.accordion-header /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.accordion-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource ArcBorderSubtle}" />
  </Style>
  <Style Selector="c|ArcIcon.accordion-chevron">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
  </Style>
  <Style Selector="c|ArcButton.accordion-header.open c|ArcIcon.accordion-chevron">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>

  <!-- ============================ Expandable text ============================ -->
  <Style Selector="a|ArcExpandableText c|ArcButton">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="a|ArcExpandableText c|ArcButton:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="a|ArcExpandableText c|ArcButton:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="a|ArcExpandableText c|ArcButton /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ============================ Messages ============================ -->
  <Style Selector="Border.toast-surface">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPanel}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ArcShadowFloating}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="MinWidth" Value="300" />
  </Style>
  <Style Selector="c|ArcIcon.toast-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" />
  </Style>
  <Style Selector="Border.alert-surface">
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPanel}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="c|ArcIcon.alert-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentStrong}" />
  </Style>
  <Style Selector="c|ArcIcon.alert-icon.success">
    <Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" />
  </Style>
  <Style Selector="c|ArcIcon.alert-icon.warning">
    <Setter Property="Foreground" Value="{DynamicResource ArcWarning}" />
  </Style>
  <Style Selector="c|ArcIcon.alert-icon.danger">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>

  </Styles>
