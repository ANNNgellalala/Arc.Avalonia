<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="using:Arc.Avalonia.Actions.Controls"
                    xmlns:c="using:Arc.Avalonia.Controls">

  <!-- ============================ Dropdown menu ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcDropdownMenu}" TargetType="a:ArcDropdownMenu">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <c:ArcButton x:Name="Trigger"
                       Variant="Secondary"
                       Size="Md" />
          <Canvas x:Name="Overlay" ClipToBounds="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================ Context menu ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcContextMenu}" TargetType="a:ArcContextMenu">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <Border x:Name="Ring"
                  Margin="-3"
                  CornerRadius="{DynamicResource ArcRadiusPanel}"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Target"
                  Background="Transparent"
                  CornerRadius="{DynamicResource ArcRadiusPanel}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
          <Canvas x:Name="Overlay" ClipToBounds="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
