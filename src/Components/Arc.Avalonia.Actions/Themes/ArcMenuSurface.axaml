<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="using:Arc.Avalonia.Internal">
<ControlTheme x:Key="{x:Type i:ArcMenuSurface}" TargetType="i:ArcMenuSurface">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPanel}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource ArcShadowFloating}"
                Padding="{TemplateBinding Padding}"
                MinWidth="{TemplateBinding MinWidth}"
                MaxWidth="{TemplateBinding MaxWidth}">
          <Panel x:Name="PART_MenuHost">
            <i:ArcGlide x:Name="PART_Highlight" CornerRadius="{DynamicResource ArcRadiusControl}" />
            <StackPanel x:Name="PART_Items" Spacing="2" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
