<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Arc.Avalonia.Actions</RootNamespace>
    <AssemblyName>Arc.Avalonia.Actions</AssemblyName>
    <PackageId>Arc.Avalonia.Actions</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Buttons, button groups, menus, disclosure, messages and the account user menu for Arc for Avalonia.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="..\..\Foundation\Arc.Avalonia\Arc.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Action-shared helpers (ArcActionVisuals/ArcDismiss) are internal to this assembly after the
         former Internal project was dissolved; Navigation and Overlays are the remaining in-layer users. -->
    <InternalsVisibleTo Include="Arc.Avalonia.Docs" />
    <InternalsVisibleTo Include="Arc.Avalonia.Navigation" />
    <InternalsVisibleTo Include="Arc.Avalonia.Overlays" />
  </ItemGroup>
</Project>
