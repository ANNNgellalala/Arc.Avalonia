<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Feedback.Controls">

  <ControlTheme x:Key="{x:Type c:ArcActivityHeatmap}" TargetType="c:ArcActivityHeatmap">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PART_Summary" Classes="arc-label" VerticalAlignment="Center" />
            <ContentPresenter x:Name="PART_Actions" Grid.Column="1" VerticalAlignment="Center" />
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <c:ArcHeatmapGrid x:Name="PART_Grid" />
          </ScrollViewer>
          <TextBlock x:Name="PART_Detail" Classes="arc-caption" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
