<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Feedback.Controls">

  <ControlTheme x:Key="{x:Type c:ArcPresenceStack}" TargetType="c:ArcPresenceStack">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <Border x:Name="Ring"
                  Margin="-5"
                  CornerRadius="{DynamicResource ArcRadiusPill}"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <StackPanel Orientation="Horizontal"
                      Spacing="10"
                      ClipToBounds="False"
                      VerticalAlignment="Top">
            <Panel x:Name="PART_Stage"
                   ClipToBounds="False"
                   VerticalAlignment="Top">
              <Canvas x:Name="PART_Faces" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
              <Canvas x:Name="PART_Dots" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
              <Canvas x:Name="PART_Labels" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
            </Panel>
            <TextBlock x:Name="PART_Others"
                       Classes="arc-caption"
                       VerticalAlignment="Top"
                       TextTrimming="CharacterEllipsis"
                       IsVisible="False" />
          </StackPanel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
