<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Feedback.Controls">

  <ControlTheme x:Key="{x:Type c:ArcSkeleton}" TargetType="c:ArcSkeleton">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <StackPanel x:Name="PART_Placeholder" Spacing="10" />
          <ContentPresenter x:Name="PART_Content"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
