<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Arc.Avalonia.Feedback</RootNamespace>
    <AssemblyName>Arc.Avalonia.Feedback</AssemblyName>
    <PackageId>Arc.Avalonia.Feedback</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Progress, avatars, presence, activity and feedback states for Arc for Avalonia.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="..\..\Foundation\Arc.Avalonia\Arc.Avalonia.csproj" />
    <ProjectReference Include="..\Arc.Avalonia.Actions\Arc.Avalonia.Actions.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- FeedbackUi/ArcTween are internal to this assembly after the former Internal project was dissolved;
         DataDisplay is the only remaining in-layer user. Docs does NOT get the grant: its moved pages call
         the AIWidgets `Sv.Paint` extension, and exposing FeedbackUi.Paint there would make those calls
         ambiguous (CS0121). -->
    <InternalsVisibleTo Include="Arc.Avalonia.DataDisplay" />
  </ItemGroup>
</Project>
