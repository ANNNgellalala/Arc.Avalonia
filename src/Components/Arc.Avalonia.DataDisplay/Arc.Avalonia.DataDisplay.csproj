<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Arc.Avalonia.DataDisplay</RootNamespace>
    <AssemblyName>Arc.Avalonia.DataDisplay</AssemblyName>
    <PackageId>Arc.Avalonia.DataDisplay</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Sortable table, tree table, tree view, data grid, filter toolbar, code block and JSON viewer for Arc for Avalonia.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="..\..\Foundation\Arc.Avalonia\Arc.Avalonia.csproj" />
    <ProjectReference Include="..\Arc.Avalonia.Actions\Arc.Avalonia.Actions.csproj" />
    <ProjectReference Include="..\Arc.Avalonia.Feedback\Arc.Avalonia.Feedback.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arc.Avalonia.Docs" />
  </ItemGroup>
</Project>
