<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Media.Controls"
                    xmlns:ac="using:Arc.Avalonia.Controls">

  <ControlTheme x:Key="{x:Type c:ArcHoldToConfirm}" TargetType="c:ArcHoldToConfirm">
    <Setter Property="Background" Value="{DynamicResource ArcDangerSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="{DynamicResource ArcControlHeightLg}" />
    <Setter Property="MinWidth" Value="232" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <Border x:Name="Ring"
                  Margin="-4"
                  CornerRadius="{DynamicResource ArcRadiusControl}"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True"
                  RenderTransformOrigin="0.5,0.5">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" />
              </Transitions>
            </Border.Transitions>
            <Grid>
              <Border x:Name="PART_Fill"
                      HorizontalAlignment="Left"
                      Width="0"
                      Background="{DynamicResource ArcDanger}"
                      IsHitTestVisible="False" />
              <StackPanel x:Name="PART_BaseRow"
                          Orientation="Horizontal"
                          Spacing="8"
                          Margin="18,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ac:ArcIcon x:Name="PART_IconBase"
                            Icon="trash-2"
                            Size="16"
                            Foreground="{DynamicResource ArcDanger}" />
                <TextBlock x:Name="PART_LabelBase"
                           Text="Hold to delete project"
                           FontSize="{DynamicResource ArcTextSm}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource ArcDanger}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Border x:Name="PART_Clip"
                      Width="0"
                      HorizontalAlignment="Left"
                      ClipToBounds="True"
                      IsHitTestVisible="False">
                <Grid x:Name="PART_FillRow" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal"
                              Spacing="8"
                              Margin="18,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <ac:ArcIcon x:Name="PART_IconFill"
                                Icon="trash-2"
                                Size="16"
                                Foreground="{DynamicResource ArcDangerForeground}" />
                    <TextBlock x:Name="PART_LabelFill"
                               Text="Hold to delete project"
                               FontSize="{DynamicResource ArcTextSm}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource ArcDangerForeground}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock x:Name="PART_Status"
                         Height="0"
                         Opacity="0"
                         IsHitTestVisible="False"
                         AutomationProperties.LiveSetting="Polite" />
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Neutral tone: the same fill language without the danger colour. -->
    <Style Selector="^.neutral">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
      <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.neutral /template/ Border#Fill">
      <Setter Property="Background" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.neutral /template/ ac|ArcIcon#IconBase">
      <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.neutral /template/ TextBlock#LabelBase">
      <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.neutral /template/ ac|ArcIcon#IconFill">
      <Setter Property="Foreground" Value="{DynamicResource ArcBackground}" />
    </Style>
    <Style Selector="^.neutral /template/ TextBlock#LabelFill">
      <Setter Property="Foreground" Value="{DynamicResource ArcBackground}" />
    </Style>

    <!-- Done: quiet success, the fill retracts and the face reports the result. -->
    <Style Selector="^.confirmed">
      <Setter Property="Background" Value="{DynamicResource ArcSuccessSubtle}" />
      <Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" />
    </Style>
    <Style Selector="^.confirmed /template/ Border#Fill">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.confirmed /template/ ac|ArcIcon#IconBase">
      <Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" />
    </Style>
    <Style Selector="^.confirmed /template/ TextBlock#LabelBase">
      <Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" />
    </Style>
    <Style Selector="^.confirmed /template/ Border#Root">
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>

    <!-- Press feedback replaces the button's own scale because the press is a hold, not a click. -->
    <Style Selector="^.holding /template/ Border#Root">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <Style Selector="^.danger:pointerover /template/ Border#Root">
      <Setter Property="Opacity" Value="0.94" />
    </Style>
    <Style Selector="^.neutral:pointerover /template/ Border#Root">
      <Setter Property="Opacity" Value="0.94" />
    </Style>

    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>
</ResourceDictionary>


