<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Arc.Avalonia.Media</RootNamespace>
    <AssemblyName>Arc.Avalonia.Media</AssemblyName>
    <PackageId>Arc.Avalonia.Media</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Hold to confirm, swipe actions, reactions, image compare, carousel, card stack, scroll area and resizable panels for Arc for Avalonia.</Description>
