<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Arc.Avalonia.Charts</RootNamespace>
    <AssemblyName>Arc.Avalonia.Charts</AssemblyName>
    <PackageId>Arc.Avalonia.Charts</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Data-visualisation controls (line, bar, donut, gauge, sankey, treemap, realtime stream and more) for Arc for Avalonia.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="..\..\Foundation\Arc.Avalonia\Arc.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arc.Avalonia.Docs" />
  </ItemGroup>
</Project>
