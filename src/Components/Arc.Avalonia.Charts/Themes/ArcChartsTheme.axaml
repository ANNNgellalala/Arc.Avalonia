      </ControlTheme>

      <ControlTheme x:Key="{x:Type charts:ArcDonutChart}" TargetType="charts:ArcDonutChart">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="StrokeWidth" Value="1" />
      </ControlTheme>

      <ControlTheme x:Key="{x:Type charts:ArcFunnelChart}" TargetType="charts:ArcFunnelChart">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="StrokeWidth" Value="1" />
      </ControlTheme>

      <ControlTheme x:Key="{x:Type charts:ArcGauge}" TargetType="charts:ArcGauge">
