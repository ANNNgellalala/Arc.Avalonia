        <Setter Property="StrokeWidth" Value="1" />
      </ControlTheme>

      <ControlTheme x:Key="{x:Type charts:ArcSunburstChart}" TargetType="charts:ArcSunburstChart">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="StrokeWidth" Value="1" />
      </ControlTheme>

      <ControlTheme x:Key="{x:Type charts:ArcTreemap}" TargetType="charts:ArcTreemap">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClipToBounds" Value="True" />
