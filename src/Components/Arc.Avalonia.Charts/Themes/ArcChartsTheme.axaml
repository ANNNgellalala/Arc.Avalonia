        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="StrokeWidth" Value="1" />
      </ControlTheme>

      <ControlTheme x:Key="{x:Type charts:ArcSankeyFlow}" TargetType="charts:ArcSankeyFlow">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="StrokeWidth" Value="1" />
      </ControlTheme>

