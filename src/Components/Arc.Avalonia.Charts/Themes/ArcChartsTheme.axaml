      </ControlTheme>

      <ControlTheme x:Key="{x:Type charts:ArcStreamgraph}" TargetType="charts:ArcStreamgraph">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClipToBounds" Value="True" />
