      <ControlTheme x:Key="{x:Type charts:ArcSplitBar}" TargetType="charts:ArcSplitBar">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
