<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Controls"
                    xmlns:p="using:Arc.Avalonia.Pickers.Controls">

  <!-- A quiet icon button: clear search. -->
  <ControlTheme x:Key="ArcEmojiIconButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Ring"
                  Margin="-3"
                  CornerRadius="11"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- A recently used emoji chip. -->
  <ControlTheme x:Key="ArcEmojiRecentTheme" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Ring"
                  Margin="-3"
                  CornerRadius="13"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcBorder}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcBorderStrong}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- Grid row container: no chrome, no focus, no selection fill. -->
  <ControlTheme x:Key="ArcEmojiRowItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Category tab: the active group is the accent-tinted pill. -->
  <ControlTheme x:Key="ArcEmojiTabItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7,6" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                CornerRadius="12"
                Padding="{TemplateBinding Padding}"
                VerticalAlignment="Center">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.16" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    </Style>
    <Style Selector="^:selected /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcAccentSubtle}" />
    </Style>
  </ControlTheme>

  <!-- Skin tone chip: a toned hand in a ring. -->
  <ControlTheme x:Key="ArcEmojiToneItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="9999" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Root"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcBorderStrong}" />
    </Style>
    <Style Selector="^:selected /template/ Border#Root">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcAccent}" />
    </Style>
  </ControlTheme>

  <!-- The embedded search field: Arc owns the template so no Fluent field chrome leaks into the panel. -->
  <ControlTheme x:Key="ArcEmojiSearchBox" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ArcForeground}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource ArcAccentSubtle}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ScrollViewer x:Name="PART_ScrollViewer"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden">
          <TextPresenter x:Name="PART_TextPresenter"
                         Text="{TemplateBinding Text, Mode=TwoWay}"
                         CaretIndex="{TemplateBinding CaretIndex}"
                         SelectionStart="{TemplateBinding SelectionStart}"
                         SelectionEnd="{TemplateBinding SelectionEnd}"
                         SelectionBrush="{TemplateBinding SelectionBrush}"
                         CaretBrush="{TemplateBinding CaretBrush}"
                         TextAlignment="{TemplateBinding TextAlignment}"
                         TextWrapping="{TemplateBinding TextWrapping}"
                         VerticalAlignment="Center" />
        </ScrollViewer>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- The picker panel. It draws its own surface so it can sit inline as well as inside a popover. -->
  <ControlTheme x:Key="{x:Type p:ArcEmojiPicker}" TargetType="p:ArcEmojiPicker">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Width" Value="360" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Surface"
                IsVisible="{TemplateBinding IsOpen}"
                Background="{DynamicResource ArcSurfaceRaised}"
                BorderBrush="{DynamicResource ArcBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ArcRadiusPanel}"
                BoxShadow="{DynamicResource ArcShadowFloating}"
                ClipToBounds="False">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,252">

            <!-- Search -->
            <Border x:Name="SearchHost"
                    Grid.Row="0"
                    Classes="emoji-search"
                    Margin="12,12,12,6"
                    Padding="8,2,4,2"
                    Background="{DynamicResource ArcSurfaceMuted}"
                    BorderThickness="2"
                    BorderBrush="Transparent"
                    CornerRadius="12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:ArcIcon Grid.Column="0"
                           Icon="search"
                           Size="16"
                           Margin="2,0,8,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PART_SearchPlaceholder"
                           Grid.Column="1"
                           Text="{TemplateBinding SearchPlaceholder}"
                           Foreground="{DynamicResource ArcTextMuted}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <TextBox x:Name="PART_Search"
                         Grid.Column="1"
                         Classes="emoji-search-input"
                         Theme="{StaticResource ArcEmojiSearchBox}" />
                <Button x:Name="PART_Clear"
                        Grid.Column="2"
                        Theme="{StaticResource ArcEmojiIconButton}"
                        ToolTip.Tip="Clear search"
                        AutomationProperties.Name="Clear search"
                        IsVisible="False">
                  <c:ArcIcon Icon="x" Size="14" />
                </Button>
              </Grid>
            </Border>

            <!-- Preview, result count and skin tones -->
            <Grid Grid.Row="1"
                  Height="40"
                  Margin="14,0,10,4"
                  ColumnDefinitions="Auto,*,Auto">
              <TextBlock x:Name="PART_PreviewGlyph"
                         Grid.Column="0"
                         Text="🙂"
                         FontSize="20"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="1"
                          Margin="8,0,8,0"
                          Spacing="1"
                          VerticalAlignment="Center">
                <TextBlock x:Name="PART_PreviewName"
                           Text="Pick an emoji"
                           FontSize="{DynamicResource ArcTextXs}"
                           Foreground="{DynamicResource ArcTextSecondary}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PART_Count"
                           Classes="arc-caption"
                           AutomationProperties.LiveSetting="Polite"
                           IsVisible="False" />
              </StackPanel>
              <Border x:Name="ToneFrame"
                      Grid.Column="2"
                      Classes="emoji-frame"
                      CornerRadius="9999">
                <ListBox x:Name="PART_Tones"
                         Height="30"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="2,0"
                         SelectionMode="Single"
                         ItemContainerTheme="{StaticResource ArcEmojiToneItem}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="p:ArcEmojiToneOption">
                      <TextBlock Text="{Binding Glyph}"
                                 FontSize="13"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Grid>

            <!-- Category bar -->
            <Border Grid.Row="2" Classes="emoji-frame" CornerRadius="12" Margin="8,0,8,0">
              <ListBox x:Name="PART_Categories"
                       Height="40"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="2,0"
                       SelectionMode="Single"
                       ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       ItemContainerTheme="{StaticResource ArcEmojiTabItem}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="p:ArcEmojiCategoryOption">
                    <TextBlock Text="{Binding Glyph}"
                               FontSize="17"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               ToolTip.Tip="{Binding Label}"
                               AutomationProperties.Name="{Binding Label}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>

            <!-- Recently used -->
            <Border x:Name="PART_RecentHost"
                    Grid.Row="3"
                    IsVisible="False"
                    BorderBrush="{DynamicResource ArcBorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Margin="0,4,0,0"
                    Padding="14,8,14,6">
              <StackPanel Spacing="6">
                <TextBlock Text="Recently used" Classes="arc-caption" />
                <StackPanel x:Name="PART_RecentRow" Orientation="Horizontal" />
              </StackPanel>
            </Border>

            <!-- Virtualised grid -->
            <Border Grid.Row="4"
                    Classes="emoji-frame"
                    CornerRadius="0,0,26,26"
                    Margin="0,0,0,0">
              <Grid>
                <ListBox x:Name="PART_Grid"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8,2,8,10"
                         SelectionMode="Single"
                         ItemContainerTheme="{StaticResource ArcEmojiRowItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="p:ArcEmojiRow">
                      <StackPanel>
                        <TextBlock Text="{Binding Header}"
                                   IsVisible="{Binding HasHeader}"
                                   Height="30"
                                   Margin="10,0,0,0"
                                   Classes="arc-caption"
                                   VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding Cells}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="p:ArcEmojiCell">
                              <Border Width="{Binding Size}"
                                      Height="{Binding Size}"
                                      Margin="2"
                                      Classes="emoji-cell"
                                      CornerRadius="8"
                                      ToolTip.Tip="{Binding Name}"
                                      AutomationProperties.Name="{Binding Name}">
                                <Panel>
                                  <Border CornerRadius="8"
                                          BorderThickness="2"
                                          BorderBrush="{DynamicResource ArcAccent}"
                                          Background="{DynamicResource ArcAccentSubtle}"
                                          IsVisible="{Binding IsActive}" />
                                  <TextBlock Text="{Binding Glyph}"
                                             FontSize="{Binding FontSize}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Panel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="PART_Empty"
                        Background="{DynamicResource ArcSurface}"
                        IsVisible="False"
                        CornerRadius="0,0,26,26">
                  <StackPanel Spacing="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <c:ArcIcon Icon="search"
                               Size="20"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="No emoji match that search"
                               Classes="arc-caption"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>




