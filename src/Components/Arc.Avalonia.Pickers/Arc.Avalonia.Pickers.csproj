<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Arc.Avalonia.Pickers</RootNamespace>
    <AssemblyName>Arc.Avalonia.Pickers</AssemblyName>
    <PackageId>Arc.Avalonia.Pickers</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Calendar, date and time, colour, emoji, file and signature pickers for Arc for Avalonia.</Description>
