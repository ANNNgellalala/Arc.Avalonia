<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="using:Arc.Avalonia.Navigation.Controls"
                    xmlns:i="using:Arc.Avalonia.Internal"
                    xmlns:c="using:Arc.Avalonia.Controls">

  <!-- ============================ Tabs ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcTabs}" TargetType="a:ArcTabs">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="16">
          <Border x:Name="Track"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource ArcSurfaceMuted}"
                  CornerRadius="{DynamicResource ArcRadiusControl}"
                  Padding="3">
            <Panel>
              <Panel x:Name="PART_GlideLayer" IsHitTestVisible="False">
                <i:ArcGlide x:Name="PART_Glide" CornerRadius="16" />
              </Panel>
              <StackPanel x:Name="PART_Triggers" Orientation="Horizontal" Spacing="2" />
            </Panel>
          </Border>
          <ContentControl x:Name="PART_PanelHost" HorizontalContentAlignment="Left" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================ Breadcrumb ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcBreadcrumb}" TargetType="a:ArcBreadcrumb">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <WrapPanel x:Name="PART_Crumbs" Orientation="Horizontal" VerticalAlignment="Center" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================ Pagination ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcPagination}" TargetType="a:ArcPagination">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel x:Name="PART_Buttons" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>

