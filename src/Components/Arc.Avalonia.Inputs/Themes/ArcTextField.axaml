<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Arc.Avalonia.Inputs.Controls;assembly=Arc.Avalonia.Inputs"
                    xmlns:arc="clr-namespace:Arc.Avalonia.Controls;assembly=Arc.Avalonia.Foundation"
                    xmlns:conv="using:Avalonia.Data.Converters">

  <!-- Text entry family: input, textarea, password field, search field. -->

  <ControlTheme x:Key="{x:Type c:ArcInput}" TargetType="c:ArcInput">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="6">
          <TextBlock Text="{TemplateBinding Label}"
                     Classes="arc-label"
                     IsVisible="{TemplateBinding Label, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
          <Border x:Name="Shell"
                  MinHeight="{DynamicResource ArcControlHeightMd}"
                  Padding="{TemplateBinding Padding}"
                  Background="{DynamicResource ArcSurface}"
                  BorderBrush="{DynamicResource ArcBorderStrong}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource ArcRadiusControl}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                <BrushTransition Property="Background" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
              <arc:ArcIcon x:Name="PART_LeadingIcon"
                         Grid.Column="0"
                         Size="18"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource ArcTextMuted}"
                         IsVisible="False" />
              <TextBox FocusAdorner="{x:Null}" Classes="arc-bare" x:Name="PART_Input"
                       Grid.Column="1"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0"
                       MinHeight="0"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}"
                       CaretBrush="{DynamicResource ArcAccentStrong}"
                       PlaceholderForeground="{DynamicResource ArcTextMuted}"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center"
                       AcceptsReturn="False"
                       TextWrapping="NoWrap" />
              <arc:ArcIcon x:Name="PART_TrailingIcon"
                         Grid.Column="2"
                         Size="18"
                         Margin="10,0,0,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource ArcTextMuted}"
                         IsVisible="False" />
              <Button x:Name="PART_ClearAction"
                      Grid.Column="3"
                      Theme="{DynamicResource ArcIconButtonTheme}"
                      Margin="4,0,0,0"
                      IsVisible="False">
                <Path Data="M6 6 L18 18 M18 6 L6 18"
                        Stroke="{DynamicResource ArcTextMuted}"
                        StrokeThickness="1.75"
                        StrokeLineCap="Round"
                        Stretch="Uniform"
                        Width="14"
                        Height="14" />
              </Button>
            </Grid>
          </Border>
          <TextBlock x:Name="PART_Message"
                     Classes="arc-caption"
                     TextWrapping="Wrap"
                     IsVisible="False" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.sm">
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.sm /template/ Border#Shell">
      <Setter Property="MinHeight" Value="{DynamicResource ArcControlHeightSm}" />
    </Style>
    <Style Selector="^.lg">
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="^.lg /template/ Border#Shell">
      <Setter Property="MinHeight" Value="{DynamicResource ArcControlHeightLg}" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcTextMuted}" />
    </Style>
    <Style Selector="^.focus /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.invalid /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.invalid /template/ TextBlock#Message">
      <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.disabled /template/ Border#Shell">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    </Style>
    <Style Selector="^.disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:ArcTextarea}" TargetType="c:ArcTextarea">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="6">
          <TextBlock Text="{TemplateBinding Label}"
                     Classes="arc-label"
                     IsVisible="{TemplateBinding Label, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
          <Border x:Name="Shell"
                  Padding="{TemplateBinding Padding}"
                  Background="{DynamicResource ArcSurface}"
                  BorderBrush="{DynamicResource ArcBorderStrong}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource ArcRadiusControl}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                <BrushTransition Property="Background" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <TextBox FocusAdorner="{x:Null}" Classes="arc-bare" x:Name="PART_Input"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     MinHeight="96"
                     FontSize="{TemplateBinding FontSize}"
                     Foreground="{TemplateBinding Foreground}"
                     CaretBrush="{DynamicResource ArcAccentStrong}"
                     PlaceholderForeground="{DynamicResource ArcTextMuted}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top" />
          </Border>
          <Grid x:Name="PART_MessageRow" ColumnDefinitions="*,Auto" IsVisible="False">
            <TextBlock x:Name="PART_Message"
                       Classes="arc-caption"
                       TextWrapping="Wrap"
                       IsVisible="False" />
            <TextBlock x:Name="PART_Counter"
                       Grid.Column="1"
                       Classes="arc-caption"
                       Margin="8,0,0,0"
                       IsVisible="False" />
          </Grid>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.sm">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.lg">
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="FontSize" Value="15" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcTextMuted}" />
    </Style>
    <Style Selector="^.focus /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.invalid /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.invalid /template/ TextBlock#Message">
      <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.disabled /template/ Border#Shell">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    </Style>
    <Style Selector="^.disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:ArcPasswordField}" TargetType="c:ArcPasswordField">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="6">
          <TextBlock Text="{TemplateBinding Label}"
                     Classes="arc-label"
                     IsVisible="{TemplateBinding Label, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
          <Border x:Name="Shell"
                  MinHeight="{DynamicResource ArcControlHeightMd}"
                  Padding="{TemplateBinding Padding}"
                  Background="{DynamicResource ArcSurface}"
                  BorderBrush="{DynamicResource ArcBorderStrong}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource ArcRadiusControl}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                <BrushTransition Property="Background" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
              <arc:ArcIcon x:Name="PART_LeadingIcon"
                         Grid.Column="0"
                         Size="18"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource ArcTextMuted}"
                         IsVisible="False" />
              <TextBox FocusAdorner="{x:Null}" Classes="arc-bare" x:Name="PART_Input"
                       Grid.Column="1"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0"
                       MinHeight="0"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}"
                       CaretBrush="{DynamicResource ArcAccentStrong}"
                       PlaceholderForeground="{DynamicResource ArcTextMuted}"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center"
                       AcceptsReturn="False" />
              <arc:ArcIcon x:Name="PART_TrailingIcon"
                         Grid.Column="2"
                         Size="18"
                         Margin="10,0,0,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource ArcTextMuted}"
                         IsVisible="False" />
              <Button x:Name="PART_RevealAction"
                      Grid.Column="3"
                      Theme="{DynamicResource ArcIconButtonTheme}"
                      Margin="4,0,0,0">
                <arc:ArcIcon x:Name="PART_RevealGlyph" Icon="eye" Size="16" Foreground="{DynamicResource ArcTextMuted}" />
              </Button>
              <Button x:Name="PART_ClearAction"
                      Grid.Column="4"
                      Theme="{DynamicResource ArcIconButtonTheme}"
                      Margin="2,0,0,0"
                      IsVisible="False">
                <Path Data="M6 6 L18 18 M18 6 L6 18"
                        Stroke="{DynamicResource ArcTextMuted}"
                        StrokeThickness="1.75"
                        StrokeLineCap="Round"
                        Stretch="Uniform"
                        Width="14"
                        Height="14" />
              </Button>
            </Grid>
          </Border>
          <StackPanel Spacing="2">
            <TextBlock x:Name="PART_Message"
                       Classes="arc-caption"
                       TextWrapping="Wrap"
                       IsVisible="False" />
            <TextBlock x:Name="PART_CapsHint"
                       Classes="arc-caption"
                       Text="Caps Lock is on"
                       IsVisible="False" />
          </StackPanel>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.sm">
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.sm /template/ Border#Shell">
      <Setter Property="MinHeight" Value="{DynamicResource ArcControlHeightSm}" />
    </Style>
    <Style Selector="^.lg">
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="^.lg /template/ Border#Shell">
      <Setter Property="MinHeight" Value="{DynamicResource ArcControlHeightLg}" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcTextMuted}" />
    </Style>
    <Style Selector="^.focus /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.invalid /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.invalid /template/ TextBlock#Message">
      <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.invalid /template/ TextBlock#CapsHint">
      <Setter Property="Foreground" Value="{DynamicResource ArcWarning}" />
    </Style>
    <Style Selector="^.disabled /template/ Border#Shell">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    </Style>
    <Style Selector="^.disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:ArcSearchField}" TargetType="c:ArcSearchField">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="6">
          <TextBlock Text="{TemplateBinding Label}"
                     Classes="arc-label"
                     IsVisible="{TemplateBinding Label, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
          <Border x:Name="Shell"
                  MinHeight="{DynamicResource ArcControlHeightMd}"
                  Padding="{TemplateBinding Padding}"
                  Background="{DynamicResource ArcSurface}"
                  BorderBrush="{DynamicResource ArcBorderStrong}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource ArcRadiusControl}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                <BrushTransition Property="Background" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
              <arc:ArcIcon Grid.Column="0"
                         Icon="search"
                         Size="18"
                         Margin="2,0,10,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource ArcTextMuted}" />
              <TextBox FocusAdorner="{x:Null}" Classes="arc-bare" x:Name="PART_Input"
                       Grid.Column="1"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0"
                       MinHeight="0"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}"
                       CaretBrush="{DynamicResource ArcAccentStrong}"
                       PlaceholderForeground="{DynamicResource ArcTextMuted}"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center"
                       AcceptsReturn="False"
                       TextWrapping="NoWrap" />
              <Border x:Name="PART_ShortcutPill"
                      Grid.Column="2"
                      Background="{DynamicResource ArcSurfaceMuted}"
                      CornerRadius="6"
                      Padding="6,2"
                      Margin="8,0,4,0"
                      VerticalAlignment="Center"
                      IsVisible="False">
                <TextBlock x:Name="PART_ShortcutHint" Classes="arc-caption" />
              </Border>
              <Button x:Name="PART_ClearAction"
                      Grid.Column="3"
                      Theme="{DynamicResource ArcIconButtonTheme}"
                      Margin="2,0,0,0"
                      IsVisible="False">
                <Path Data="M6 6 L18 18 M18 6 L6 18"
                        Stroke="{DynamicResource ArcTextMuted}"
                        StrokeThickness="1.75"
                        StrokeLineCap="Round"
                        Stretch="Uniform"
                        Width="14"
                        Height="14" />
              </Button>
            </Grid>
          </Border>
          <TextBlock x:Name="PART_Message"
                     Classes="arc-caption"
                     TextWrapping="Wrap"
                     IsVisible="False" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.sm">
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.sm /template/ Border#Shell">
      <Setter Property="MinHeight" Value="{DynamicResource ArcControlHeightSm}" />
    </Style>
    <Style Selector="^.lg">
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="^.lg /template/ Border#Shell">
      <Setter Property="MinHeight" Value="{DynamicResource ArcControlHeightLg}" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcTextMuted}" />
    </Style>
    <Style Selector="^.focus /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.invalid /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.invalid /template/ TextBlock#Message">
      <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.disabled /template/ Border#Shell">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    </Style>
    <Style Selector="^.disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>  </ControlTheme>
</ResourceDictionary>
