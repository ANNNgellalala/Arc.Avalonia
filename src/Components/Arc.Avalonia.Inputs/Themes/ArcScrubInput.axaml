<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ai="using:Arc.Avalonia.Inputs.Controls">

  <!-- Scrub input: a compact inspector field. The label is the drag handle, the value is a bare text box. -->
  <ControlTheme x:Key="{x:Type ai:ArcScrubInput}" TargetType="ai:ArcScrubInput">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="MinHeight" Value="{DynamicResource ArcControlHeightMd}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <Border x:Name="PART_Shell"
                  MinHeight="{TemplateBinding MinHeight}"
                  Padding="12,0,6,0"
                  Background="{DynamicResource ArcSurface}"
                  BorderBrush="{DynamicResource ArcBorderStrong}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource ArcRadiusControl}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <Border.RenderTransform>
              <TranslateTransform />
            </Border.RenderTransform>
            <Grid RowDefinitions="*,Auto">
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Border x:Name="PART_Handle"
                        Background="Transparent"
                        CornerRadius="12"
                        Padding="4,6,8,6"
                        Margin="-4,0,0,0"
                        Cursor="SizeWestEast"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Drag to scrub. Shift is coarse, Alt is fine. Double-click resets.">
                  <Border.Transitions>
                    <Transitions>
                      <BrushTransition Property="Background" Duration="0:0:0.12" />
                    </Transitions>
                  </Border.Transitions>
                  <TextBlock x:Name="PART_LabelText"
                             Classes="arc-label"
                             Foreground="{DynamicResource ArcTextSecondary}"
                             VerticalAlignment="Center" />
                </Border>
                <TextBox x:Name="PART_Value"
                         Grid.Column="1"
                         Classes="arc-bare"
                         FocusAdorner="{x:Null}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         MinHeight="0"
                         Margin="2,0,6,0"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         FontWeight="Medium"
                         Foreground="{TemplateBinding Foreground}"
                         CaretBrush="{DynamicResource ArcAccentStrong}"
                         PlaceholderForeground="{DynamicResource ArcTextMuted}"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         AcceptsReturn="False"
                         TextWrapping="NoWrap" />
                <Button x:Name="PART_UnitButton"
                        Grid.Column="2"
                        Theme="{DynamicResource ArcAdvancedTextButton}"
                        Margin="0,0,2,0"
                        VerticalAlignment="Center"
                        IsVisible="False">
                  <TextBlock x:Name="PART_UnitText"
                             FontSize="{DynamicResource ArcTextXs}"
                             FontWeight="Medium"
                             Foreground="{DynamicResource ArcTextSecondary}" />
                </Button>
              </Grid>
              <Panel x:Name="PART_FillHost" Grid.Row="1" Height="2" Margin="0,0,0,4" Background="Transparent">
                <Border Height="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource ArcBorder}"
                        CornerRadius="1" />
                <Border x:Name="PART_TrackFill"
                        Height="2"
                        Width="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource ArcAccent}"
                        Opacity="0.7"
                        CornerRadius="1"
                        IsVisible="False" />
              </Panel>
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.sm">
      <Setter Property="MinHeight" Value="{DynamicResource ArcControlHeightSm}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcTextMuted}" />
    </Style>
    <Style Selector="^.focus /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.invalid /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Handle">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    </Style>
    <Style Selector="^.disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
