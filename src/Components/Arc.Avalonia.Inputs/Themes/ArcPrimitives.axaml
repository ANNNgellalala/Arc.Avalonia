<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Small primitives shared by the input controls: icon buttons, filter chips, menu rows and
       segment buttons. They are keyed ControlThemes so generated children can pick them up. -->

  <ControlTheme x:Key="ArcIconButtonTheme" TargetType="Button">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Ring"
                  Margin="-3"
                  CornerRadius="9"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcControlTrackHover}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Root">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <!-- A filter or tag chip. Selected uses the accent role; the check grows in from code. -->
  <ControlTheme x:Key="ArcChipTheme" TargetType="Button">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="{DynamicResource ArcSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPill}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Ring"
                  Margin="-3"
                  CornerRadius="{DynamicResource ArcRadiusPill}"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    </Style>
    <Style Selector="^.selected">
      <Setter Property="Background" Value="{DynamicResource ArcAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ArcAccentForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ArcAccent}" />
    </Style>
    <Style Selector="^.selected:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcAccentStrong}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Root">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <!-- Stepper buttons inside number and money fields: quiet, square, icon only. -->
  <ControlTheme x:Key="ArcStepperButtonTheme" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Ring"
                  Margin="-2"
                  CornerRadius="10"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcControlTrackHover}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Root">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.35" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- Segment button for the segmented control; the shared pill slides behind these. -->
  <ControlTheme x:Key="ArcSegmentButtonTheme" TargetType="Button">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPill}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Ring"
                  Margin="-2"
                  CornerRadius="{DynamicResource ArcRadiusPill}"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcControlTrackHover}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.selected">
      <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.selected /template/ Border#Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    </Style>
  </ControlTheme>

  <!-- Popup list chrome shared by select, combobox and multi-select. -->
  <ControlTheme x:Key="ArcMenuListTheme" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="ItemContainerTheme" Value="{DynamicResource ArcMenuItemTheme}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </ControlTheme>

  <ControlTheme x:Key="ArcMenuItemTheme" TargetType="ListBoxItem">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                CornerRadius="12"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcControlTrackHover}" />
    </Style>
    <Style Selector="^:selected /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcAccentSubtle}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource ArcAccentStrong}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <!-- Select uses a gliding highlight behind its rows, so rows must not paint their own fill. -->
  <ControlTheme x:Key="ArcSelectMenuItemTheme" TargetType="ListBoxItem">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                CornerRadius="12"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcControlOnSubtle}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <!-- Radio rows use this full-row button theme so the whole row is the hit target. -->
  <ControlTheme x:Key="ArcRadioButtonTheme" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Ring"
                  Margin="-3"
                  CornerRadius="19"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Row"
                  Background="{TemplateBinding Background}"
                  CornerRadius="16"
                  Padding="{TemplateBinding Padding}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="Auto,*">
              <Border x:Name="Box"
                      Width="20"
                      Height="20"
                      CornerRadius="10"
                      Background="{DynamicResource ArcSurface}"
                      BorderBrush="{DynamicResource ArcBorderStrong}"
                      BorderThickness="1.5"
                      VerticalAlignment="Top"
                      Margin="0,1,0,0">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                  </Transitions>
                </Border.Transitions>
                <Border x:Name="Dot"
                        Width="8"
                        Height="8"
                        CornerRadius="4"
                        Background="{DynamicResource ArcAccent}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="False" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Row">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    </Style>
    <Style Selector="^:checked /template/ Border#Row">
      <Setter Property="Background" Value="{DynamicResource ArcAccentSubtle}" />
    </Style>
    <Style Selector="^:checked /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcAccent}" />
    </Style>
    <Style Selector="^:checked /template/ Border#Dot">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
