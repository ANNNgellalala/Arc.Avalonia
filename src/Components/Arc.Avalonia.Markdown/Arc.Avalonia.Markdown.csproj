<Project Sdk="Microsoft.NET.Sdk">
  <!--
    L2 Markdown family (ADR 0006): the production renderer for PuraMarkdown documents.
    Parsing/streaming/diagnostics come from PuraMarkdown.Core (Markdig, no Avalonia); every
    control, theme and interaction is Arc. The package reads tokens only through ArcResources so
    it follows light/dark and all eight accents like the rest of the design system.
  -->
  <PropertyGroup>
    <RootNamespace>Arc.Avalonia.Markdown</RootNamespace>
    <AssemblyName>Arc.Avalonia.Markdown</AssemblyName>
    <PackageId>Arc.Avalonia.Markdown</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Full Markdown rendering for Arc for Avalonia: PuraMarkdown.Core syntax, Arc block and inline renderers, streaming, code highlighting, tables, agent components and the AI chat surface.</Description>
    <PackageTags>avalonia;markdown;markdown-renderer;streaming;ai;chat;design-system</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="PuraMarkdown.Core" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Foundation\Arc.Avalonia\Arc.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arc.Avalonia.Docs" />
    <InternalsVisibleTo Include="Arc.Avalonia.Verify" />
    <InternalsVisibleTo Include="Arc.Avalonia.Agent" />
  </ItemGroup>
</Project>

