<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Markdown"
                    xmlns:arc="using:Arc.Avalonia.Controls">

  <!--
    Chat surface: virtualized message list + fixed streaming slot under it.
    Message rows are ListBox items, so only the rows inside the viewport are realized (ArcVirtualList pins
    a VirtualizingStackPanel). The item theme below strips Fluent's selection/hover chrome: a transcript is
    read, not selected. All colours come from Arc token resources.
  -->
  <ControlTheme x:Key="ArcMarkdownChatMessageItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:ArcMarkdownChatView}" TargetType="c:ArcMarkdownChatView">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource ArcBackground}" ClipToBounds="True">
          <Grid RowDefinitions="*,Auto">
            <arc:ArcVirtualList x:Name="PART_List"
                                Grid.Row="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                ItemContainerTheme="{StaticResource ArcMarkdownChatMessageItem}" />
            <ContentControl x:Name="PART_StreamingSlot"
                            Grid.Row="1"
                            IsVisible="False"
                            HorizontalContentAlignment="Stretch" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
