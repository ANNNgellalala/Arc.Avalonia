<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:e="using:Arc.Avalonia.Effects.Controls">

  <ControlTheme x:Key="{x:Type e:ArcHoverCard}" TargetType="e:ArcHoverCard">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="PART_Layer" ClipToBounds="False">
          <ContentPresenter x:Name="PART_TriggerHost"
                            Content="{TemplateBinding Trigger}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
          <Canvas x:Name="PART_Overlay" ClipToBounds="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
