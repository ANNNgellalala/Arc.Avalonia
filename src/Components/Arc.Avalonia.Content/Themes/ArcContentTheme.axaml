<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Arc.Avalonia.Content/Themes/ArcRichTextEditor.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Content/Themes/ArcReorderableList.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Content/Themes/ArcOnboardingChecklist.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!--
    Bare native TextBoxes (rich text editor, inline editors, composer fields) mark themselves with the
    `arc-bare` class. The shared suppression of Fluent's TextBox frame and the TextPresenter colours live
    in the Foundation layer (Arc.Avalonia.Theme/ArcBaseStyles.axaml) so every Arc package, including the
    text-field family in Arc.Avalonia.Inputs, gets the same behaviour from one definition.
  -->
</Styles>
