<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Content.Controls">

  <ControlTheme x:Key="{x:Type c:ArcReorderableList}" TargetType="c:ArcReorderableList">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="PART_Host" ClipToBounds="False">
          <StackPanel x:Name="PART_Rows" Spacing="8" ClipToBounds="False" />
          <TextBlock x:Name="PART_Live" Height="1" Opacity="0" IsHitTestVisible="False"
                     TextWrapping="Wrap" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
