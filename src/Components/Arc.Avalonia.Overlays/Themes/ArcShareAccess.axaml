<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="using:Arc.Avalonia.Overlays.Controls"
                    xmlns:c="using:Arc.Avalonia.Controls">

  <!-- ============================ Share access ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcShareAccess}" TargetType="a:ArcShareAccess">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MaxWidth" Value="440" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Surface"
                Classes="sa-panel"
                ClipToBounds="False"
                MinWidth="380"
                MaxWidth="{TemplateBinding MaxWidth}">
          <Panel ClipToBounds="False">
            <StackPanel Margin="20" Spacing="16">
              <!-- Heading -->
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock x:Name="PART_Heading" Classes="arc-heading" TextWrapping="Wrap" VerticalAlignment="Center" />
                <c:ArcButton x:Name="PART_DoneButton"
                             Grid.Column="1"
                             Variant="Secondary"
                             Size="Sm"
                             Content="Done"
                             IsVisible="False"
                             Margin="12,0,0,0" />
              </Grid>

              <!-- Invite field, error line and invite row -->
              <StackPanel Spacing="8">
                <Panel>
                  <Border x:Name="PART_FieldRing"
                          Classes="sa-field-ring"
                          Margin="-3"
                          IsVisible="False" />
                  <Border x:Name="PART_FieldShell"
                          Classes="sa-field"
                          MinHeight="46"
                          Padding="6,4">
                    <Panel>
                      <TextBlock x:Name="PART_Placeholder"
                                 Classes="arc-body-sm sa-placeholder"
                                 Text="Add people by name or email"
                                 Margin="8,0"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False" />
                      <WrapPanel x:Name="PART_Chips" Orientation="Horizontal" VerticalAlignment="Center" />
                    </Panel>
                  </Border>
                </Panel>

                <StackPanel x:Name="PART_ErrorRow"
                            Orientation="Horizontal"
                            Spacing="6"
                            IsVisible="False"
                            Margin="2,0">
                  <c:ArcIcon Icon="circle-alert" Size="14" Classes="sa-error-icon" VerticalAlignment="Center" />
                  <TextBlock x:Name="PART_ErrorText"
                             Classes="arc-caption sa-error-text"
                             TextWrapping="Wrap"
                             MaxWidth="360" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <c:ArcButton x:Name="PART_InviteRole"
                               Variant="Ghost"
                               Size="Sm"
                               Height="32"
                               MinHeight="32"
                               Padding="8,0"
                               HorizontalAlignment="Left" />
                  <c:ArcButton x:Name="PART_InviteButton"
                               Grid.Column="1"
                               Variant="Primary"
                               Size="Sm"
                               Height="34"
                               MinHeight="34"
                               Content="Invite" />
                </Grid>
              </StackPanel>

              <!-- People with access -->
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,2">
                  <TextBlock Classes="arc-label" Text="People with access" />
                  <TextBlock x:Name="PART_PeopleCount" Grid.Column="1" Classes="arc-caption" VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="PART_PeopleHost" Orientation="Vertical" Spacing="1" />
                <Border x:Name="PART_UndoBar"
                        Classes="sa-undo"
                        IsVisible="False"
                        Height="0"
                        Opacity="0"
                        ClipToBounds="True"
                        Margin="0,4,0,0">
                  <Grid ColumnDefinitions="*,Auto" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PART_UndoText" Classes="arc-caption sa-undo-text" VerticalAlignment="Center" />
                    <c:ArcButton x:Name="PART_UndoButton"
                                 Grid.Column="1"
                                 Variant="Ghost"
                                 Size="Sm"
                                 Height="28"
                                 MinHeight="28"
                                 Padding="10,0"
                                 Content="Undo" />
                  </Grid>
                </Border>
              </StackPanel>

              <Border Classes="sa-divider" Height="1" />

              <!-- General access -->
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Border x:Name="PART_AccessIconBox"
                        Classes="sa-icon-box"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center">
                  <c:ArcIcon x:Name="PART_AccessIcon"
                             Icon="lock"
                             Size="16"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1" Margin="10,0" VerticalAlignment="Center">
                  <TextBlock x:Name="PART_AccessTitle" Classes="arc-body-sm arc-medium" />
                  <TextBlock x:Name="PART_AccessDescription"
                             Classes="arc-caption"
                             TextWrapping="Wrap"
                             MaxWidth="260" />
                </StackPanel>
                <c:ArcButton x:Name="PART_AccessButton"
                             Grid.Column="2"
                             Variant="Secondary"
                             Size="Sm"
                             Height="30"
                             MinHeight="30"
                             Padding="10,0"
                             Content="Change"
                             VerticalAlignment="Center" />
              </Grid>

              <Grid x:Name="PART_LinkRoleRow"
                    ColumnDefinitions="*,Auto"
                    IsVisible="False"
                    Margin="42,0,0,0">
                <TextBlock Classes="arc-caption"
                           Text="Anyone with the link can"
                           VerticalAlignment="Center" />
                <c:ArcButton x:Name="PART_LinkRoleButton"
                             Grid.Column="1"
                             Variant="Ghost"
                             Size="Sm"
                             Height="30"
                             MinHeight="30"
                             Padding="8,0"
                             VerticalAlignment="Center" />
              </Grid>

              <!-- Link and copy -->
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <Border Classes="sa-link" Height="34" Padding="10,0" VerticalAlignment="Center">
                  <TextBlock x:Name="PART_LinkText"
                             Classes="arc-body-sm sa-link-text"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </Border>
                <c:ArcButton x:Name="PART_CopyButton"
                             Grid.Column="1"
                             Variant="Secondary"
                             Size="Sm"
                             Height="34"
                             MinHeight="34"
                             Padding="10,0"
                             Margin="8,0,0,0"
                             Width="132"
                             VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <c:ArcIcon x:Name="PART_CopyIcon" Icon="copy" Size="15" Classes="sa-copy-icon" VerticalAlignment="Center" />
                    <TextBlock x:Name="PART_CopyLabel" Text="Copy link" VerticalAlignment="Center" />
                  </StackPanel>
                </c:ArcButton>
              </Grid>
            </StackPanel>

            <Canvas x:Name="PART_Overlay" ClipToBounds="False" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
