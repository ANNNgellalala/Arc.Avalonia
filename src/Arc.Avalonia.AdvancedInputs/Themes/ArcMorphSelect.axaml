<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ai="using:Arc.Avalonia.AdvancedInputs.Controls"
                    xmlns:arc="using:Arc.Avalonia.Controls">

  <!-- Morph select: one surface is both the trigger and the list; it grows in place. -->
  <ControlTheme x:Key="{x:Type ai:ArcMorphSelect}" TargetType="ai:ArcMorphSelect">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="6">
          <TextBlock x:Name="LabelText" Classes="arc-label" />
          <Panel ClipToBounds="False" Height="44">
            <Border x:Name="Surface"
                    Width="240"
                    Height="44"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    ZIndex="10"
                    ClipToBounds="True"
                    Background="{DynamicResource ArcSurface}"
                    BorderBrush="{DynamicResource ArcBorderStrong}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ArcRadiusControl}">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
              </Border.Transitions>
              <Grid RowDefinitions="44,*">
                <Grid x:Name="TriggerRow" ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="ValueText"
                             Margin="14,0,8,0"
                             FontSize="{TemplateBinding FontSize}"
                             Foreground="{DynamicResource ArcForeground}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <TextBox x:Name="PART_Search"
                           Classes="arc-bare"
                           FocusAdorner="{x:Null}"
                           Margin="12,0,4,0"
                           Padding="0"
                           MinHeight="0"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           Foreground="{DynamicResource ArcForeground}"
                           CaretBrush="{DynamicResource ArcAccentStrong}"
                           PlaceholderForeground="{DynamicResource ArcTextMuted}"
                           Background="Transparent"
                           BorderThickness="0"
                           VerticalAlignment="Center"
                           VerticalContentAlignment="Center"
                           IsVisible="False" />
                  <arc:ArcIcon x:Name="Chevron"
                               Grid.Column="1"
                               Icon="chevron-down"
                               Size="14"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource ArcTextMuted}"
                               VerticalAlignment="Center" />
                </Grid>
                <Panel x:Name="ListHost" Grid.Row="1" IsVisible="False">
                  <ScrollViewer x:Name="Scroller"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <Panel x:Name="OptionsHost" Margin="0,2,0,6">
                      <Border x:Name="Highlight"
                              Height="36"
                              Margin="4,0,4,0"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource ArcSurfaceMuted}"
                              CornerRadius="10"
                              IsHitTestVisible="False"
                              IsVisible="False" />
                      <StackPanel x:Name="Options" />
                    </Panel>
                  </ScrollViewer>
                </Panel>
              </Grid>
            </Border>
          </Panel>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.open">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Surface">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcTextMuted}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Surface">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcFocusOutline}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="^.disabled">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
