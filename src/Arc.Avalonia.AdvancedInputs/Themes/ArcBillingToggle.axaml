<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ai="using:Arc.Avalonia.AdvancedInputs.Controls">

  <!-- Billing toggle: one quiet track with a surface thumb gliding behind the options. -->
  <ControlTheme x:Key="{x:Type ai:ArcBillingToggle}" TargetType="ai:ArcBillingToggle">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Track"
                Background="{DynamicResource ArcSurfaceMuted}"
                CornerRadius="{DynamicResource ArcRadiusPill}"
                Padding="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
          <Panel x:Name="Host">
            <Border x:Name="Thumb"
                    Width="0"
                    Height="36"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ArcSurface}"
                    CornerRadius="{DynamicResource ArcRadiusPill}"
                    BoxShadow="{DynamicResource ArcShadowResting}">
              <Border.RenderTransform>
                <TranslateTransform />
              </Border.RenderTransform>
            </Border>
            <StackPanel x:Name="OptionsHost"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
