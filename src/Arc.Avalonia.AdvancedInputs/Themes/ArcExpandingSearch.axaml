<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ai="using:Arc.Avalonia.AdvancedInputs.Controls"
                    xmlns:arc="using:Arc.Avalonia.Controls">

  <!-- Expanding search: an icon that becomes a field, with grouped results beneath. -->
  <ControlTheme x:Key="{x:Type ai:ArcExpandingSearch}" TargetType="ai:ArcExpandingSearch">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="Host" ClipToBounds="False" MinHeight="40">
          <Border x:Name="Field"
                  Width="40"
                  Height="40"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  ZIndex="10"
                  ClipToBounds="True"
                  Background="{DynamicResource ArcSurfaceMuted}"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="20">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <arc:ArcIcon x:Name="Icon"
                           Icon="search"
                           Size="18"
                           Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ArcTextSecondary}" />
              <TextBox x:Name="PART_Query"
                       Grid.Column="1"
                       Classes="arc-bare"
                       FocusAdorner="{x:Null}"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0"
                       MinHeight="0"
                       Margin="9,0,4,0"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{DynamicResource ArcForeground}"
                       CaretBrush="{DynamicResource ArcAccentStrong}"
                       PlaceholderForeground="{DynamicResource ArcTextMuted}"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center"
                       IsVisible="False" />
              <Button x:Name="ClearButton"
                      Grid.Column="2"
                      Theme="{DynamicResource ArcAdvancedIconButton}"
                      Width="24"
                      Height="24"
                      Margin="0,0,8,0"
                      AutomationProperties.Name="Clear search"
                      IsVisible="False"
                      VerticalAlignment="Center">
                <arc:ArcIcon Icon="x" Size="13" Foreground="{DynamicResource ArcTextMuted}" />
              </Button>
            </Grid>
          </Border>

          <Border x:Name="Panel"
                  IsVisible="False"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Right"
                  Margin="0,46,0,0"
                  Width="300"
                  MaxHeight="340"
                  ZIndex="20"
                  ClipToBounds="False"
                  Background="{DynamicResource ArcSurface}"
                  BorderBrush="{DynamicResource ArcBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource ArcRadiusPanel}"
                  BoxShadow="{DynamicResource ArcShadowFloating}"
                  Padding="6">
            <ScrollViewer MaxHeight="300"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="Rows" Spacing="1" />
            </ScrollViewer>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.expanded /template/ Border#Field">
      <Setter Property="Background" Value="{DynamicResource ArcSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ArcBorderStrong}" />
    </Style>
    <Style Selector="^.expanded">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^.focus /template/ Border#Field">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.collapsed:pointerover /template/ Border#Field">
      <Setter Property="Background" Value="{DynamicResource ArcBorder}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Field">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcFocusOutline}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="^.disabled">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
