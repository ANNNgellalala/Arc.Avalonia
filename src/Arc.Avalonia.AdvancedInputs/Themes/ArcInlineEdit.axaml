<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ai="using:Arc.Avalonia.AdvancedInputs.Controls"
                    xmlns:arc="using:Arc.Avalonia.Controls">

  <!-- Inline edit: the resting text and the field share padding, so the text never moves on activation. -->
  <ControlTheme x:Key="{x:Type ai:ArcInlineEdit}" TargetType="ai:ArcInlineEdit">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="6">
          <Panel>
            <Border x:Name="Resting"
                    Background="Transparent"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="-14,-10">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
              </Border.Transitions>
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock x:Name="RestingText"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Panel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <arc:ArcIcon x:Name="Pencil"
                               Icon="pencil"
                               Size="16"
                               IsVisible="False"
                               Foreground="{DynamicResource ArcTextMuted}" />
                  <arc:ArcIcon x:Name="SavedMark"
                               Icon="check"
                               Size="16"
                               IsVisible="False"
                               Foreground="{DynamicResource ArcSuccess}" />
                </Panel>
              </Grid>
            </Border>

            <Border x:Name="Ring"
                    Margin="-18,-12"
                    CornerRadius="12"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource ArcFocusOutline}"
                    IsVisible="False"
                    IsHitTestVisible="False" />

            <Border x:Name="Editor"
                    MinHeight="44"
                    Padding="14,0"
                    Background="{DynamicResource ArcSurface}"
                    BorderBrush="{DynamicResource ArcBorderStrong}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ArcRadiusControl}"
                    IsVisible="False">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
              </Border.Transitions>
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
                <TextBox x:Name="PART_Editor"
                         Classes="arc-bare"
                         FocusAdorner="{x:Null}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         MinHeight="0"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{DynamicResource ArcTextSm}"
                         Foreground="{TemplateBinding Foreground}"
                         CaretBrush="{DynamicResource ArcAccentStrong}"
                         PlaceholderForeground="{DynamicResource ArcTextMuted}"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         TextWrapping="NoWrap" />
                <arc:ArcSpinner x:Name="Busy"
                                Grid.Column="1"
                                Size="16"
                                StrokeWidth="2"
                                Margin="8,0,2,0"
                                IsVisible="False"
                                Stroke="{DynamicResource ArcAccent}"
                                VerticalAlignment="Center" />
                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Theme="{DynamicResource ArcAdvancedIconButton}"
                        AutomationProperties.Name="Save"
                        VerticalAlignment="Center">
                  <arc:ArcIcon Icon="check"
                               Size="16"
                               Foreground="{DynamicResource ArcAccent}" />
                </Button>
                <Button x:Name="CancelButton"
                        Grid.Column="3"
                        Theme="{DynamicResource ArcAdvancedIconButton}"
                        AutomationProperties.Name="Cancel"
                        VerticalAlignment="Center">
                  <arc:ArcIcon Icon="x" Size="16" Foreground="{DynamicResource ArcTextMuted}" />
                </Button>
              </Grid>
            </Border>
          </Panel>

          <TextBlock x:Name="Message"
                     Classes="arc-caption"
                     TextWrapping="Wrap"
                     IsVisible="False" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Resting">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    </Style>
    <Style Selector="^:pointerover /template/ arc|ArcIcon#Pencil">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.editing">
      <Setter Property="Cursor" Value="Ibeam" />
    </Style>
    <Style Selector="^.editing /template/ Border#Editor">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.multiline /template/ Border#Editor">
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="^.multiline /template/ TextBox#PART_Editor">
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="True" />
    </Style>
    <Style Selector="^.invalid /template/ Border#Editor">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.saving /template/ Border#Editor">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcBorderStrong}" />
    </Style>
    <Style Selector="^.disabled">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
