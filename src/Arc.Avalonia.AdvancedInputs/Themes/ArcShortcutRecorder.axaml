<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ai="using:Arc.Avalonia.AdvancedInputs.Controls"
                    xmlns:arc="using:Arc.Avalonia.Controls">

  <!-- Shortcut recorder: a field that reads as a button, with key caps for the chord. -->
  <ControlTheme x:Key="{x:Type ai:ArcShortcutRecorder}" TargetType="ai:ArcShortcutRecorder">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="6">
          <TextBlock x:Name="LabelText" Classes="arc-label" />
          <Panel>
            <Border x:Name="Shell"
                    MinHeight="{DynamicResource ArcControlHeightMd}"
                    Background="{DynamicResource ArcSurface}"
                    BorderBrush="{DynamicResource ArcBorderStrong}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ArcRadiusControl}">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                  <BrushTransition Property="Background" Duration="0:0:0.16" />
                </Transitions>
              </Border.Transitions>
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Border x:Name="RecordingDot"
                        Grid.Column="0"
                        Width="8"
                        Height="8"
                        CornerRadius="4"
                        Margin="13,0,0,0"
                        Background="{DynamicResource ArcAccent}"
                        IsVisible="False"
                        VerticalAlignment="Center" />
                <Panel Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel x:Name="Caps"
                              Orientation="Horizontal"
                              Spacing="4"
                              Margin="12,0,4,0"
                              IsVisible="False" />
                  <TextBlock x:Name="PlaceholderText"
                             Classes="arc-body-sm"
                             Foreground="{DynamicResource ArcTextMuted}"
                             Margin="12,0,4,0"
                             TextTrimming="CharacterEllipsis" />
                </Panel>
                <Button x:Name="ClearButton"
                        Grid.Column="2"
                        Theme="{DynamicResource ArcAdvancedIconButton}"
                        Margin="2,0,7,0"
                        AutomationProperties.Name="Clear shortcut"
                        IsVisible="False"
                        VerticalAlignment="Center">
                  <arc:ArcIcon Icon="x" Size="14" Foreground="{DynamicResource ArcTextMuted}" />
                </Button>
              </Grid>
            </Border>

            <Border x:Name="Ring"
                    Margin="-3"
                    CornerRadius="21"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource ArcFocusOutline}"
                    IsVisible="False"
                    IsHitTestVisible="False" />
          </Panel>

          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock x:Name="Message"
                         Classes="arc-caption"
                         Foreground="{DynamicResource ArcWarning}"
                         IsVisible="False"
                         VerticalAlignment="Center" />
              <Button x:Name="UseButton"
                      Theme="{DynamicResource ArcAdvancedTextButton}"
                      FontSize="{DynamicResource ArcTextXs}"
                      Content="Use anyway"
                      IsVisible="False" />
              <Button x:Name="CancelButton"
                      Theme="{DynamicResource ArcAdvancedTextButton}"
                      FontSize="{DynamicResource ArcTextXs}"
                      Content="Cancel"
                      IsVisible="False" />
            </StackPanel>
            <TextBlock x:Name="Hint"
                       Classes="arc-caption"
                       TextWrapping="Wrap"
                       IsVisible="False" />
          </StackPanel>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcTextMuted}" />
    </Style>
    <Style Selector="^.recording /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcAccent}" />
      <Setter Property="Background" Value="{DynamicResource ArcSurface}" />
    </Style>
    <Style Selector="^.conflict /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcWarning}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.disabled">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
