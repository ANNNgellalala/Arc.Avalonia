<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ai="using:Arc.Avalonia.AdvancedInputs.Controls"
                    xmlns:arc="using:Arc.Avalonia.Controls">

  <!-- Phone input: country button, national display and a searchable picker that grows out of the button. -->
  <ControlTheme x:Key="{x:Type ai:ArcPhoneInput}" TargetType="ai:ArcPhoneInput">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <StackPanel x:Name="Stack" Spacing="6">
            <TextBlock x:Name="LabelText" Classes="arc-label" />
            <Border x:Name="Shell"
                    MinHeight="{DynamicResource ArcControlHeightMd}"
                    Background="{DynamicResource ArcSurface}"
                    BorderBrush="{DynamicResource ArcBorderStrong}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ArcRadiusControl}">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
              </Border.Transitions>
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
                <Button x:Name="CountryButton"
                        Theme="{DynamicResource ArcAdvancedTextButton}"
                        Padding="4,4"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ArcSurfaceMuted}"
                            CornerRadius="6"
                            Padding="6,2"
                            VerticalAlignment="Center">
                      <TextBlock x:Name="IsoText"
                                 FontSize="11"
                                 FontWeight="Medium"
                                 LetterSpacing="0.4"
                                 Foreground="{DynamicResource ArcTextSecondary}" />
                    </Border>
                    <TextBlock x:Name="DialText"
                               Classes="arc-body-sm"
                               Foreground="{DynamicResource ArcTextSecondary}"
                               VerticalAlignment="Center" />
                    <arc:ArcIcon Icon="chevron-down"
                                 Size="12"
                                 Foreground="{DynamicResource ArcTextMuted}"
                                 VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Border Grid.Column="1"
                        Width="1"
                        Height="18"
                        Margin="4,0,2,0"
                        Background="{DynamicResource ArcBorder}" />
                <TextBox x:Name="PART_Number"
                         Grid.Column="2"
                         Classes="arc-bare"
                         FocusAdorner="{x:Null}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         MinHeight="0"
                         Margin="8,0,4,0"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         Foreground="{TemplateBinding Foreground}"
                         CaretBrush="{DynamicResource ArcAccentStrong}"
                         PlaceholderText="(415) 555-0132"
                         PlaceholderForeground="{DynamicResource ArcTextMuted}"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         AcceptsReturn="False"
                         TextWrapping="NoWrap" />
                <arc:ArcIcon x:Name="ValidMark"
                             Grid.Column="3"
                             Icon="check"
                             Size="16"
                             Margin="2,0,12,0"
                             IsVisible="False"
                             Foreground="{DynamicResource ArcSuccess}"
                             VerticalAlignment="Center" />
              </Grid>
            </Border>
            <TextBlock x:Name="Message"
                       Classes="arc-caption"
                       TextWrapping="Wrap"
                       IsVisible="False" />
          </StackPanel>

          <Border x:Name="Picker"
                  IsVisible="False"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"
                  ZIndex="20"
                  ClipToBounds="False"
                  Background="{DynamicResource ArcSurface}"
                  BorderBrush="{DynamicResource ArcBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource ArcRadiusPanel}"
                  BoxShadow="{DynamicResource ArcShadowFloating}"
                  Padding="6">
            <StackPanel Spacing="4">
              <TextBox x:Name="PART_Search"
                       Classes="arc-bare"
                       BorderBrush="Transparent"
                       FocusAdorner="{x:Null}"
                       Background="{DynamicResource ArcSurfaceMuted}"
                       BorderThickness="0"
                       CornerRadius="10"
                       Padding="10,7"
                       MinHeight="0"
                       Margin="4,4,4,2"
                       FontSize="{DynamicResource ArcTextSm}"
                       Foreground="{DynamicResource ArcForeground}"
                       CaretBrush="{DynamicResource ArcAccentStrong}"
                       PlaceholderText="Search countries"
                       PlaceholderForeground="{DynamicResource ArcTextMuted}" />
              <ScrollViewer x:Name="Scroller"
                            MaxHeight="264"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Rows" />
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcTextMuted}" />
    </Style>
    <Style Selector="^.focus /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.invalid /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
