<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:aa="using:Arc.Avalonia.AdvancedActions.Controls"
        xmlns:c="using:Arc.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Arc.Avalonia.AdvancedActions/Themes/ArcActionButton.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.AdvancedActions/Themes/ArcFloatingButtonGroup.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.AdvancedActions/Themes/ArcExpandingButtonGroup.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.AdvancedActions/Themes/ArcIconMorph.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.AdvancedActions/Themes/ArcUserMenu.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ============================ Floating button group items ============================ -->
  <!-- The tray highlight is the only hover and focus treatment; buttons keep their box. -->
  <Style Selector="c|ArcButton.floating-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="c|ArcButton.floating-item:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.floating-item:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.floating-item:pressed /template/ Border#Root">
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>
  <Style Selector="c|ArcButton.floating-item /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|ArcButton.floating-item.is-pressed">
    <Setter Property="Background" Value="{DynamicResource ArcAccentSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.floating-item.fbt-disabled">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
  </Style>

  <!-- ============================ Expanding button group items ============================ -->
  <Style Selector="c|ArcButton.expanding-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="c|ArcButton.expanding-item:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>
  <Style Selector="c|ArcButton.expanding-item:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.expanding-item:pressed /template/ Border#Root">
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>
  <Style Selector="c|ArcButton.expanding-item /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|ArcButton.expanding-item.expanded">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.expanding-item.expanded.danger-item">
    <Setter Property="Background" Value="{DynamicResource ArcDangerSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcButton.expanding-item.expanded.done-item">
    <Setter Property="Background" Value="{DynamicResource ArcSuccessSubtle}" />
  </Style>
  <Style Selector="c|ArcButton.expanding-item.expanded.danger-item.done-item">
    <Setter Property="Background" Value="{DynamicResource ArcDangerSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcButton.expanding-item.disabled-item">
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
  </Style>

  <Style Selector="c|ArcIcon.expand-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>
  <Style Selector="c|ArcButton.expanding-item.expanded c|ArcIcon.expand-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.expanding-item.expanded.danger-item c|ArcIcon.expand-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcButton.expanding-item.expanded.done-item c|ArcIcon.expand-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" />
  </Style>
  <Style Selector="c|ArcButton.expanding-item.expanded.danger-item.done-item c|ArcIcon.expand-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>

  <!-- ============================ User menu ============================ -->
  <Style Selector="c|ArcButton.user-menu-trigger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-trigger:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-trigger:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-trigger.open /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-trigger:pressed /template/ Border#Root">
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>

  <Style Selector="Border.user-menu-portrait">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPill}" />
  </Style>
  <Style Selector="Border.user-menu-stage">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPanel}" />
  </Style>
  <Style Selector="Border.user-menu-topbar">
    <Setter Property="Background" Value="{DynamicResource ArcSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
  </Style>
  <Style Selector="Border.user-menu-settings-bar">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
  </Style>
  <Style Selector="TextBlock.user-menu-initials">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>
  <Style Selector="Border.user-menu-presence">
    <Setter Property="BorderBrush" Value="{DynamicResource ArcSurfaceMuted}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.user-menu-presence.status-available">
    <Setter Property="Background" Value="{DynamicResource ArcSuccess}" />
  </Style>
  <Style Selector="Border.user-menu-presence.status-busy">
    <Setter Property="Background" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="Border.user-menu-presence.status-away">
    <Setter Property="Background" Value="{DynamicResource ArcWarning}" />
  </Style>
  <Style Selector="Border.user-menu-presence-bar">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="Border.user-menu-presence-hole">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="TextBlock.user-menu-trigger-name">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="MaxWidth" Value="176" />
  </Style>
  <Style Selector="c|ArcIcon.user-menu-chevron">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
  </Style>

  <Style Selector="TextBlock.user-menu-name">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="MaxWidth" Value="150" />
  </Style>
  <Style Selector="Border.user-menu-plan">
    <Setter Property="Background" Value="{DynamicResource ArcAccentSubtle}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="5,1" />
  </Style>
  <Style Selector="TextBlock.user-menu-plan-text">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentStrong}" />
  </Style>
  <Style Selector="TextBlock.user-menu-email">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
  </Style>

  <Style Selector="Border.user-menu-separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource ArcBorderSubtle}" />
    <Setter Property="Margin" Value="0,6" />
  </Style>

  <Style Selector="c|ArcButton.user-menu-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-row.danger">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-row:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-row.danger:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-row:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-row:pressed /template/ Border#Root">
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-row /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-row /template/ ContentPresenter#Content">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.user-menu-segments">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="Border.user-menu-thumb">
    <Setter Property="Background" Value="{DynamicResource ArcSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-segment:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-segment:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-segment.selected">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-segment /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-segment:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ArcFocusOutline}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="c|ArcButton.user-menu-segment:pressed /template/ Border#Root">
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>
  <Style Selector="c|ArcIcon.user-menu-theme-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>
  <Style Selector="TextBlock.user-menu-theme-label">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
</Styles>
