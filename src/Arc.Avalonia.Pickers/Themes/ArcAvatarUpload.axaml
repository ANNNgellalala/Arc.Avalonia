<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Controls"
                    xmlns:p="using:Arc.Avalonia.Pickers.Controls">

  <!-- The avatar itself is one button, so the whole disc opens the picker and takes keyboard focus. -->
  <ControlTheme x:Key="ArcAvatarButtonTheme" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <Border x:Name="Ring"
                  Margin="-5"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type p:ArcAvatarUpload}" TargetType="p:ArcAvatarUpload">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="10" ClipToBounds="False">

          <!-- Avatar and its states -->
          <Grid ColumnDefinitions="Auto,*" ClipToBounds="False">
            <Panel Grid.Column="0"
                   Width="{TemplateBinding Size}"
                   Height="{TemplateBinding Size}"
                   ClipToBounds="False">
              <Button x:Name="PART_AvatarButton"
                      Theme="{StaticResource ArcAvatarButtonTheme}"
                      Width="{TemplateBinding Size}"
                      Height="{TemplateBinding Size}">
                <Grid x:Name="PART_AvatarBox"
                      Width="{TemplateBinding Size}"
                      Height="{TemplateBinding Size}">
                  <Border x:Name="PART_PhotoClip" ClipToBounds="True" IsVisible="False">
                    <Image x:Name="PART_Photo" Stretch="UniformToFill" />
                  </Border>
                  <Border x:Name="PART_InitialsHost" Background="{DynamicResource ArcSurfaceMuted}">
                    <TextBlock x:Name="PART_Initials"
                               Text="AL"
                               Classes="arc-label"
                               Foreground="{DynamicResource ArcTextSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <Border x:Name="PART_Hover"
                          IsVisible="False"
                          Background="{DynamicResource ArcScrim}"
                          IsHitTestVisible="False">
                    <c:ArcIcon Icon="image"
                               Size="22"
                               Foreground="{DynamicResource ArcForeground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <Border x:Name="PART_Drop"
                          IsVisible="False"
                          Background="{DynamicResource ArcAccentSubtle}"
                          BorderThickness="2"
                          BorderBrush="{DynamicResource ArcAccent}"
                          IsHitTestVisible="False">
                    <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <c:ArcIcon Icon="upload"
                                 Size="18"
                                 Foreground="{DynamicResource ArcAccent}"
                                 HorizontalAlignment="Center" />
                      <TextBlock Text="Drop photo"
                                 Classes="arc-caption"
                                 Foreground="{DynamicResource ArcAccent}"
                                 HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Button>

              <Border x:Name="PART_Pending"
                      IsVisible="False"
                      ClipToBounds="True"
                      IsHitTestVisible="False">
                <Panel>
                  <Image x:Name="PART_PendingPhoto" Stretch="UniformToFill" />
                  <Border Background="{DynamicResource ArcScrim}" />
                </Panel>
              </Border>

              <p:ArcAvatarRing x:Name="PART_Ring"
                               Width="102"
                               Height="102"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="False"
                               IsHitTestVisible="False" />

              <Border x:Name="PART_Settle"
                      Width="{TemplateBinding Size}"
                      Height="{TemplateBinding Size}"
                      CornerRadius="9999"
                      BorderThickness="2"
                      BorderBrush="{DynamicResource ArcAccent}"
                      IsVisible="False"
                      IsHitTestVisible="False" />

              <Border x:Name="PART_Check"
                      Width="26"
                      Height="26"
                      Background="{DynamicResource ArcSuccess}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,-4,-4"
                      IsVisible="False">
                <c:ArcIcon Icon="check"
                           Size="14"
                           Foreground="{DynamicResource ArcBackground}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </Panel>

            <StackPanel Grid.Column="1"
                        Margin="16,0,0,0"
                        Spacing="4"
                        VerticalAlignment="Center">
              <TextBlock x:Name="PART_Label" Classes="arc-label" Text="Profile photo" />
              <TextBlock x:Name="PART_Name" Classes="arc-caption" IsVisible="False" />
              <TextBlock x:Name="PART_Hint"
                         Classes="arc-caption"
                         TextWrapping="Wrap"
                         MaxWidth="280"
                         HorizontalAlignment="Left" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <c:ArcButton x:Name="PART_UploadButton"
                             Variant="Secondary"
                             Size="Sm"
                             Content="Upload photo" />
                <c:ArcButton x:Name="PART_RetryButton"
                             Variant="Secondary"
                             Size="Sm"
                             Content="Try again"
                             IsVisible="False" />
                <c:ArcButton x:Name="PART_RemoveButton"
                             Variant="Ghost"
                             Size="Sm"
                             Content="Remove" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <TextBlock x:Name="PART_Status"
                     Classes="avatar-status"
                     IsVisible="False"
                     AutomationProperties.LiveSetting="Polite"
                     TextWrapping="Wrap" />


          <!-- In-place cropper -->
          <Border x:Name="PART_CropPanel"
                  IsVisible="False"
                  Background="{DynamicResource ArcSurfaceMuted}"
                  CornerRadius="{DynamicResource ArcRadiusPanel}"
                  Padding="16">
            <Grid ColumnDefinitions="Auto,*">
              <Border x:Name="CropStage"
                      Classes="avatar-crop-stage"
                      Width="248"
                      Height="248"
                      Background="{DynamicResource ArcSurface}"
                      CornerRadius="{DynamicResource ArcRadiusPanel}"
                      ClipToBounds="True">
                <p:ArcAvatarCropSurface x:Name="PART_Crop" Width="248" Height="248" />
              </Border>

              <StackPanel Grid.Column="1"
                          Margin="18,0,0,0"
                          Spacing="8"
                          VerticalAlignment="Center">
                <TextBlock Text="Crop photo" Classes="arc-label" />
                <TextBlock Text="Drag to reposition the photo. Scroll, plus or minus to zoom."
                           Classes="arc-caption"
                           TextWrapping="Wrap"
                           MaxWidth="230" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button x:Name="PART_ZoomOut"
                          Theme="{StaticResource ArcPickerIconTheme}"
                          ToolTip.Tip="Zoom out"
                          AutomationProperties.Name="Zoom out">
                    <c:ArcIcon Icon="zoom-out" Size="16" />
                  </Button>
                  <TextBlock x:Name="PART_ZoomValue"
                             Text="1.0×"
                             Classes="arc-caption"
                             Width="44"
                             TextAlignment="Center"
                             VerticalAlignment="Center" />
                  <Button x:Name="PART_ZoomIn"
                          Theme="{StaticResource ArcPickerIconTheme}"
                          ToolTip.Tip="Zoom in"
                          AutomationProperties.Name="Zoom in">
                    <c:ArcIcon Icon="zoom-in" Size="16" />
                  </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                  <c:ArcButton x:Name="PART_Save"
                               Variant="Primary"
                               Size="Sm"
                               Content="Save photo" />
                  <c:ArcButton x:Name="PART_Cancel"
                               Variant="Ghost"
                               Size="Sm"
                               Content="Cancel" />
                </StackPanel>
                <TextBlock Text="Enter saves, Escape cancels."
                           Classes="arc-caption"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>





