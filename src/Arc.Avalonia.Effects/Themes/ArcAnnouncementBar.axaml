<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Controls"
                    xmlns:e="using:Arc.Avalonia.Effects.Controls">

  <ControlTheme x:Key="{x:Type e:ArcAnnouncementBar}" TargetType="e:ArcAnnouncementBar">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Root"
                Classes="announcement-bar"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,Auto">
            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="52">
              <StackPanel x:Name="ControlHost"
                          Orientation="Horizontal"
                          Spacing="2"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          IsVisible="False">
                <c:ArcButton x:Name="PrevButton" Classes="bar-icon" Variant="Ghost" Size="Sm"
                             Compact="True" Width="32" MinHeight="32" Padding="0" />
                <c:ArcButton x:Name="PauseButton" Classes="bar-icon" Variant="Ghost" Size="Sm"
                             Compact="True" Width="32" MinHeight="32" Padding="0" />
                <c:ArcButton x:Name="NextButton" Classes="bar-icon" Variant="Ghost" Size="Sm"
                             Compact="True" Width="32" MinHeight="32" Padding="0" />
              </StackPanel>

              <Panel x:Name="MessageHost"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Stretch"
                     Margin="12,10"
                     ClipToBounds="False" />

              <c:ArcButton x:Name="DismissButton"
                           Grid.Column="2"
                           Classes="bar-icon"
                           Variant="Ghost"
                           Size="Sm"
                           Compact="True"
                           Width="32"
                           MinHeight="32"
                           Padding="0"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />
            </Grid>

            <Border x:Name="ProgressTrack"
                    Grid.Row="1"
                    Height="2"
                    Background="{DynamicResource ArcBorderSubtle}"
                    IsVisible="False"
                    ClipToBounds="True">
              <Border x:Name="ProgressFill"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource ArcAccent}"
                      Width="0" />
            </Border>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
