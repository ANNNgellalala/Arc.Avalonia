<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Arc.Avalonia.Special.Motion</RootNamespace>
    <AssemblyName>Arc.Avalonia.Special.Motion</AssemblyName>
    <PackageId>Arc.Avalonia.Special.Motion</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Motion-led special components: morph navigation, dock, orbit menu, liquid tab bar and text effects for Arc for Avalonia.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="..\..\Foundation\Arc.Avalonia\Arc.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arc.Avalonia.Docs" />
  </ItemGroup>
</Project>
