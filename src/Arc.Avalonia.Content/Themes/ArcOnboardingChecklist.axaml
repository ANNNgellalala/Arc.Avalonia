<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Content.Controls">

  <ControlTheme x:Key="{x:Type c:ArcOnboardingChecklist}" TargetType="c:ArcOnboardingChecklist">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="PART_Host" ClipToBounds="False" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
