<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Arc.Avalonia.Content/Themes/ArcRichTextEditor.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Content/Themes/ArcReorderableList.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Content/Themes/ArcChatThread.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Content/Themes/ArcOnboardingChecklist.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!--
    Fluent's TextBox paints its own accent focus border and leave it on top of the Arc framing border.
    These controls use the arc-bare class and own their focus treatment; the selection brush is also
    copied to the TextPresenter from ArcContentUi because Fluent's presenter style outranks the
    template binding.
  -->
  <Style Selector="TextBox.arc-bare /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.arc-bare:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.arc-bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.arc-bare:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBox.arc-bare /template/ TextPresenter">
    <Setter Property="SelectionBrush" Value="{DynamicResource ArcAccentSubtle}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource ArcForeground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ArcAccentStrong}" />
  </Style>
</Styles>
