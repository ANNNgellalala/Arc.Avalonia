<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shared chrome for the advanced input family: icon buttons, key caps and the option controls
       used by the billing toggle and the radio cards. -->

  <ControlTheme x:Key="ArcAdvancedIconButton" TargetType="Button">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Ring"
                  Margin="-3"
                  CornerRadius="11"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcBorder}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- A quiet inline text button: unit chips, Clear, Use anyway. -->
  <ControlTheme x:Key="ArcAdvancedTextButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextXs}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Ring"
                  Margin="-2"
                  CornerRadius="10"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Root"
                  Background="Transparent"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- A single key cap, the Kbd of the shortcut recorder and the hint rows. -->
  <ControlTheme x:Key="ArcKbdCap" TargetType="ContentControl">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextXs}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Cap"
                Background="{DynamicResource ArcSurface}"
                BorderBrush="{DynamicResource ArcBorderStrong}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="7,2"
                MinHeight="22"
                BoxShadow="{DynamicResource ArcShadowResting}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.lit /template/ Border#Cap">
      <Setter Property="Background" Value="{DynamicResource ArcAccentSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ArcAccent}" />
    </Style>
  </ControlTheme>

  <!-- One option of the billing toggle: a pill that the shared thumb slides behind. -->
  <ControlTheme x:Key="ArcSegmentOptionTheme" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Ring"
                  Margin="-2"
                  CornerRadius="{DynamicResource ArcRadiusPill}"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Root"
                  Background="Transparent"
                  CornerRadius="{DynamicResource ArcRadiusPill}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- One option card: hairline surface with a filled indicator dot; the group slides a ring over it. -->
  <ControlTheme x:Key="ArcCardOptionTheme" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Background" Value="{DynamicResource ArcSurface}" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Ring"
                  Margin="-3"
                  CornerRadius="{DynamicResource ArcRadiusPanel}"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource ArcBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource ArcRadiusPanel}"
                  Padding="{TemplateBinding Padding}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="Auto,*">
              <Border x:Name="Indicator"
                      Width="18"
                      Height="18"
                      CornerRadius="9"
                      BorderThickness="1.5"
                      BorderBrush="{DynamicResource ArcBorderStrong}"
                      VerticalAlignment="Top"
                      Margin="0,1,12,0">
                <Ellipse x:Name="Dot"
                         Width="8"
                         Height="8"
                         Fill="{DynamicResource ArcAccent}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsVisible="False" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Ellipse#Dot">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:checked /template/ Border#Indicator">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcAccent}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcBorderStrong}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
