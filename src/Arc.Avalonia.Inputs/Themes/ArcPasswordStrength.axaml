<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Arc.Avalonia.Inputs.Controls;assembly=Arc.Avalonia.Inputs"
                    xmlns:arc="clr-namespace:Arc.Avalonia.Controls;assembly=Arc.Avalonia"
                    xmlns:conv="using:Avalonia.Data.Converters">

  <ControlTheme x:Key="{x:Type c:ArcPasswordStrength}" TargetType="c:ArcPasswordStrength">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcTextSm}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="6">
          <TextBlock Text="{TemplateBinding Label}"
                     Classes="arc-label"
                     IsVisible="{TemplateBinding Label, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
          <Border x:Name="Shell"
                  MinHeight="{DynamicResource ArcControlHeightMd}"
                  Padding="{TemplateBinding Padding}"
                  Background="{DynamicResource ArcSurface}"
                  BorderBrush="{DynamicResource ArcBorderStrong}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource ArcRadiusControl}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <TextBox FocusAdorner="{x:Null}" x:Name="PART_Input"
                       Grid.Column="0"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0"
                       MinHeight="0"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}"
                       CaretBrush="{DynamicResource ArcAccentStrong}"
                       PlaceholderForeground="{DynamicResource ArcTextMuted}"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center"
                       AcceptsReturn="False" />
              <Button x:Name="RevealAction"
                      Grid.Column="1"
                      Theme="{DynamicResource ArcIconButtonTheme}"
                      Margin="4,0,0,0">
                <arc:ArcIcon x:Name="RevealGlyph" Icon="eye" Size="16" Foreground="{DynamicResource ArcTextMuted}" />
              </Button>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
            <Grid x:Name="Meter" ColumnDefinitions="*,*,*,*" Height="4" VerticalAlignment="Center" Margin="0,0,12,0">
              <Border x:Name="Seg1"
                      Grid.Column="0"
                      Classes="seg"
                      Background="{DynamicResource ArcControlTrack}"
                      CornerRadius="{DynamicResource ArcRadiusPill}"
                      Margin="0,0,4,0" />
              <Border x:Name="Seg2"
                      Grid.Column="1"
                      Classes="seg"
                      Background="{DynamicResource ArcControlTrack}"
                      CornerRadius="{DynamicResource ArcRadiusPill}"
                      Margin="0,0,4,0" />
              <Border x:Name="Seg3"
                      Grid.Column="2"
                      Classes="seg"
                      Background="{DynamicResource ArcControlTrack}"
                      CornerRadius="{DynamicResource ArcRadiusPill}"
                      Margin="0,0,4,0" />
              <Border x:Name="Seg4"
                      Grid.Column="3"
                      Classes="seg"
                      Background="{DynamicResource ArcControlTrack}"
                      CornerRadius="{DynamicResource ArcRadiusPill}" />
            </Grid>
            <TextBlock x:Name="StrengthWord"
                       Grid.Column="1"
                       Classes="arc-caption"
                       VerticalAlignment="Center" />
          </Grid>

          <StackPanel x:Name="RulesList" Spacing="1" Margin="0,2,0,0" />

          <TextBlock x:Name="Message"
                     Classes="arc-caption"
                     TextWrapping="Wrap"
                     IsVisible="False" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcTextMuted}" />
    </Style>
    <Style Selector="^.focus /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcForeground}" />
    </Style>
    <Style Selector="^.invalid /template/ Border#Shell">
      <Setter Property="BorderBrush" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.invalid /template/ TextBlock#Message">
      <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="^.level-0 /template/ Border.seg.filled">
      <Setter Property="Background" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.level-1 /template/ Border.seg.filled">
      <Setter Property="Background" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.level-2 /template/ Border.seg.filled">
      <Setter Property="Background" Value="{DynamicResource ArcWarning}" />
    </Style>
    <Style Selector="^.level-3 /template/ Border.seg.filled">
      <Setter Property="Background" Value="{DynamicResource ArcSuccess}" />
    </Style>
    <Style Selector="^.level-4 /template/ Border.seg.filled">
      <Setter Property="Background" Value="{DynamicResource ArcSuccess}" />
    </Style>
    <Style Selector="^.level-0 /template/ TextBlock#StrengthWord">
      <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.level-1 /template/ TextBlock#StrengthWord">
      <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
    </Style>
    <Style Selector="^.level-2 /template/ TextBlock#StrengthWord">
      <Setter Property="Foreground" Value="{DynamicResource ArcWarning}" />
    </Style>
    <Style Selector="^.level-3 /template/ TextBlock#StrengthWord">
      <Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" />
    </Style>
    <Style Selector="^.level-4 /template/ TextBlock#StrengthWord">
      <Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" />
    </Style>  </ControlTheme>
</ResourceDictionary>
