<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="using:Arc.Avalonia.Actions.Controls"
                    xmlns:c="using:Arc.Avalonia.Controls">

  <ControlTheme x:Key="{x:Type a:ArcMenuSurface}" TargetType="a:ArcMenuSurface">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPanel}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource ArcShadowFloating}"
                Padding="{TemplateBinding Padding}"
                MinWidth="{TemplateBinding MinWidth}"
                MaxWidth="{TemplateBinding MaxWidth}">
          <Panel x:Name="MenuHost">
            <a:ArcGlide x:Name="Highlight" CornerRadius="{DynamicResource ArcRadiusControl}" />
            <StackPanel x:Name="Items" Spacing="2" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================ Dropdown menu ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcDropdownMenu}" TargetType="a:ArcDropdownMenu">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <c:ArcButton x:Name="Trigger"
                       Variant="Secondary"
                       Size="Md" />
          <Canvas x:Name="Overlay" ClipToBounds="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================ Context menu ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcContextMenu}" TargetType="a:ArcContextMenu">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <Border x:Name="Ring"
                  Margin="-3"
                  CornerRadius="{DynamicResource ArcRadiusPanel}"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ArcFocusOutline}"
                  IsVisible="False"
                  IsHitTestVisible="False" />
          <Border x:Name="Target"
                  Background="Transparent"
                  CornerRadius="{DynamicResource ArcRadiusPanel}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
          <Canvas x:Name="Overlay" ClipToBounds="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
