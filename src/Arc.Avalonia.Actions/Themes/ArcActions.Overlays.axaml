<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="using:Arc.Avalonia.Actions.Controls"
                    xmlns:c="using:Arc.Avalonia.Controls">

  <!-- ============================ Dialog ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcDialog}" TargetType="a:ArcDialog">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Backdrop"
                  CornerRadius="{DynamicResource ArcRadiusPanel}" />
          <Border x:Name="Panel"
                  MinWidth="320"
                  MaxWidth="440"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource ArcSurface}"
                  BorderBrush="{DynamicResource ArcBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource ArcRadiusPanel}"
                  BoxShadow="{DynamicResource ArcShadowFloating}"
                  Padding="24"
                  Focusable="True"
                  RenderTransformOrigin="0.5,0.5">
            <StackPanel Spacing="6">
              <TextBlock x:Name="Title" Classes="arc-heading" TextWrapping="Wrap" />
              <TextBlock x:Name="Description"
                         Classes="arc-body-sm arc-secondary"
                         TextWrapping="Wrap"
                         Margin="0,2,0,0" />
              <ContentPresenter x:Name="Body"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Margin="0,10,0,0" />
              <ContentPresenter x:Name="FooterHost"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0" />
            </StackPanel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================ Drawer ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcDrawer}" TargetType="a:ArcDrawer">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Backdrop"
                  CornerRadius="{DynamicResource ArcRadiusPanel}" />
          <Border x:Name="Panel"
                  Width="420"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource ArcSurface}"
                  BorderBrush="{DynamicResource ArcBorder}"
                  BorderThickness="1"
                  BoxShadow="{DynamicResource ArcShadowFloating}"
                  Padding="24"
                  Focusable="True"
                  RenderTransformOrigin="0.5,0.5">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                  <TextBlock x:Name="Title" Classes="arc-heading" TextWrapping="Wrap" />
                  <TextBlock x:Name="Description"
                             Classes="arc-body-sm arc-secondary"
                             TextWrapping="Wrap" />
                </StackPanel>
                <c:ArcButton x:Name="CloseButton"
                             Grid.Column="1"
                             Variant="Ghost"
                             Size="Sm"
                             Compact="True"
                             Width="32"
                             MinHeight="32"
                             VerticalAlignment="Top"
                             Content="{x:Null}" />
              </Grid>

              <ContentPresenter x:Name="Body"
                                Grid.Row="1"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Margin="0,18,0,0" />

              <ContentPresenter x:Name="FooterHost"
                                Grid.Row="2"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0" />
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================ Popover ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcPopover}" TargetType="a:ArcPopover">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <ContentPresenter x:Name="TriggerHost"
                            Content="{TemplateBinding Trigger}"
                            HorizontalAlignment="Left" />
          <Canvas x:Name="Overlay" ClipToBounds="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================ Tooltip ============================ -->
  <ControlTheme x:Key="{x:Type a:ArcTooltip}" TargetType="a:ArcTooltip">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <ContentPresenter x:Name="TargetHost"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Left" />
          <Canvas x:Name="Overlay" ClipToBounds="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
