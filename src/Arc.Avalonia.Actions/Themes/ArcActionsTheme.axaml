<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="using:Arc.Avalonia.Actions.Controls"
        xmlns:i="using:Arc.Avalonia.Internal"
        xmlns:c="using:Arc.Avalonia.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcActions.Buttons.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcActions.Menus.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcActions.Navigation.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcActions.Overlays.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcActions.Messages.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcMegaMenu.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcShareAccess.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcActionButton.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcExpandingButtonGroup.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcFloatingButtonGroup.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcIconMorph.axaml" />
        <ResourceInclude Source="avares://Arc.Avalonia.Actions/Themes/ArcUserMenu.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ============================ Shared highlight ============================ -->
  <Style Selector="i|ArcGlide.arc-glide">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="i|ArcGlide.arc-glide.danger">
    <Setter Property="Background" Value="{DynamicResource ArcDangerSubtle}" />
  </Style>
  <Style Selector="i|ArcGlide.arc-glide.pill">
    <Setter Property="Background" Value="{DynamicResource ArcSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ============================ Menu rows ============================ -->
  <Style Selector="Border.arc-menu-separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="Background" Value="{DynamicResource ArcBorderSubtle}" />
  </Style>

  <Style Selector="c|ArcButton.menu-row">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.menu-row:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.menu-row:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.menu-row.destructive">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcButton.menu-row.destructive:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcButton.menu-row /template/ ContentPresenter#Content">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="c|ArcButton.menu-row /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ============================ Button group ============================ -->
  <Style Selector="c|ArcButton.group-segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="c|ArcButton.group-segment:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.group-segment:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.group-segment.solid">
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentForeground}" />
  </Style>
  <Style Selector="c|ArcButton.group-segment.solid:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentForeground}" />
  </Style>
  <Style Selector="c|ArcButton.group-segment.solid:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.group-segment /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|ArcIcon.group-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.group-segment.solid c|ArcIcon">
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentForeground}" />
  </Style>

  <Style Selector="Border.group-divider">
    <Setter Property="Background" Value="{DynamicResource ArcBorderSubtle}" />
  </Style>
  <Style Selector="Border.group-divider.solid">
    <Setter Property="Background" Value="{DynamicResource ArcAccentForeground}" />
    <Setter Property="Opacity" Value="0.28" />
  </Style>

  <!-- ============================ Split button ============================ -->
  <Style Selector="Border.split-divider">
    <Setter Property="Background" Value="{DynamicResource ArcBorderStrong}" />
  </Style>
  <Style Selector="Border.split-divider.primary">
    <Setter Property="Background" Value="{DynamicResource ArcAccentForeground}" />
    <Setter Property="Opacity" Value="0.32" />
  </Style>

  <!-- ============================ Action swap ============================ -->
  <Style Selector="c|ArcButton.action-swap">
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPill}" />
    <Setter Property="Padding" Value="18,0" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-success">
    <Setter Property="Background" Value="{DynamicResource ArcSuccess}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcBackground}" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-success:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcBackground}" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-success:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcSuccess}" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-warning">
    <Setter Property="Background" Value="{DynamicResource ArcWarning}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcBackground}" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-warning:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcBackground}" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-warning:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcWarning}" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="c|ArcButton.action-swap.tone-quiet">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>

  <!-- ============================ Confirm morph ============================ -->
  <Style Selector="a|ArcConfirmMorph c|ArcButton.confirm-answer">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="c|ArcIcon.confirm-done-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" />
  </Style>
  <Style Selector="c|ArcIcon.confirm-error-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcIcon.dropdown-chevron">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>

  <!-- ============================ Tabs ============================ -->
  <Style Selector="c|ArcButton.tab-trigger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="c|ArcButton.tab-trigger:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.tab-trigger:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.tab-trigger.selected">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.tab-trigger /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ============================ Breadcrumb ============================ -->
  <Style Selector="c|ArcButton.crumb-link">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.crumb-link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.crumb-link:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.crumb-link /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|ArcIcon.crumb-separator">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
  </Style>

  <!-- ============================ Pagination ============================ -->
  <Style Selector="c|ArcButton.page-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="c|ArcButton.page-button:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.page-button:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="c|ArcButton.page-button.current">
    <Setter Property="Background" Value="{DynamicResource ArcAccentSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentStrong}" />
  </Style>
  <Style Selector="c|ArcButton.page-button.current:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentStrong}" />
  </Style>
  <Style Selector="c|ArcButton.page-button.current:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcAccentSubtle}" />
  </Style>
  <Style Selector="c|ArcButton.page-button /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|ArcButton.page-arrow">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.page-arrow:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="c|ArcButton.page-arrow /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ============================ Accordion ============================ -->
  <Style Selector="c|ArcButton.accordion-header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="c|ArcButton.accordion-header:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.accordion-header /template/ ContentPresenter#Content">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="c|ArcButton.accordion-header /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.accordion-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource ArcBorderSubtle}" />
  </Style>
  <Style Selector="c|ArcIcon.accordion-chevron">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
  </Style>
  <Style Selector="c|ArcButton.accordion-header.open c|ArcIcon.accordion-chevron">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>

  <!-- ============================ Expandable text ============================ -->
  <Style Selector="a|ArcExpandableText c|ArcButton">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="a|ArcExpandableText c|ArcButton:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="a|ArcExpandableText c|ArcButton:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="a|ArcExpandableText c|ArcButton /template/ Border#Ring">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ============================ Popover and tooltip ============================ -->
  <Style Selector="Border.popover-surface">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPanel}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ArcShadowFloating}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="MinWidth" Value="192" />
    <Setter Property="MaxWidth" Value="352" />
  </Style>
  <Style Selector="Border.tooltip-surface">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ArcShadowFloating}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MaxWidth" Value="240" />
  </Style>

  <!-- ============================ Messages ============================ -->
  <Style Selector="Border.toast-surface">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPanel}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ArcShadowFloating}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="MinWidth" Value="300" />
  </Style>
  <Style Selector="c|ArcIcon.toast-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" />
  </Style>
  <Style Selector="Border.alert-surface">
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPanel}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="c|ArcIcon.alert-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentStrong}" />
  </Style>
  <Style Selector="c|ArcIcon.alert-icon.success">
    <Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" />
  </Style>
  <Style Selector="c|ArcIcon.alert-icon.warning">
    <Setter Property="Foreground" Value="{DynamicResource ArcWarning}" />
  </Style>
  <Style Selector="c|ArcIcon.alert-icon.danger">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>

  <!-- ============================ Pro: mega menu morph ============================ -->
  <Style Selector="Border.mm-bar">
    <Setter Property="Background" Value="{DynamicResource ArcSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
  </Style>
  <Style Selector="i|ArcGlide.mm-caret">
    <Setter Property="Background" Value="{DynamicResource ArcAccent}" />
  </Style>
  <Style Selector="c|ArcButton.mm-brand">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="c|ArcButton.mm-brand:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.mm-brand:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="Border.mm-brand-mark">
    <Setter Property="Background" Value="{DynamicResource ArcAccentSubtle}" />
  </Style>
  <Style Selector="c|ArcIcon.mm-brand-mark-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentStrong}" />
  </Style>
  <Style Selector="c|ArcButton.mm-trigger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="c|ArcButton.mm-trigger:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.mm-trigger:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ArcButton.mm-trigger.open">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.mm-trigger.current">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcIcon.mm-chevron">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
  </Style>
  <Style Selector="Border.mm-panel">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPanel}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ArcShadowFloating}" />
  </Style>
  <Style Selector="c|ArcButton.mm-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="c|ArcButton.mm-link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.mm-link:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="Border.mm-icon-box">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="c|ArcIcon.mm-link-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>
  <Style Selector="Border.mm-group-divider">
    <Setter Property="Background" Value="{DynamicResource ArcBorderSubtle}" />
  </Style>
  <Style Selector="Border.mm-band">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="Border.mm-status-dot">
    <Setter Property="Background" Value="{DynamicResource ArcSuccess}" />
  </Style>
  <Style Selector="c|ArcButton.mm-feature-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="c|ArcButton.mm-feature-button:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.mm-feature">
    <Setter Property="Background" Value="{DynamicResource ArcGradientSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="c|ArcButton.mm-feature-button:pointerover Border.mm-feature">
    <Setter Property="BorderBrush" Value="{DynamicResource ArcAccent}" />
  </Style>
  <Style Selector="c|ArcIcon.mm-feature-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentStrong}" />
  </Style>
  <Style Selector="TextBlock.mm-feature-cta">
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentStrong}" />
  </Style>
  <Style Selector="c|ArcIcon.mm-feature-cta">
    <Setter Property="Foreground" Value="{DynamicResource ArcAccentStrong}" />
  </Style>
  <Style Selector="c|ArcButton.mm-action.quiet">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>
  <Style Selector="Border.mm-sheet">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPanel}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ArcShadowFloating}" />
  </Style>
  <Style Selector="c|ArcButton.mm-sheet-header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="c|ArcButton.mm-sheet-header:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="Border.mm-sheet-divider">
    <Setter Property="Background" Value="{DynamicResource ArcBorderSubtle}" />
  </Style>
  <Style Selector="c|ArcButton.mm-sheet-action">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="c|ArcButton.mm-sheet-action:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>

  <!-- ============================ Pro: share access ============================ -->
  <Style Selector="Border.sa-panel">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPanel}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ArcShadowFloating}" />
  </Style>
  <Style Selector="Border.sa-field">
    <Setter Property="Background" Value="{DynamicResource ArcSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
  </Style>
  <Style Selector="Border.sa-field:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource ArcTextMuted}" />
  </Style>
  <Style Selector="Border.sa-field.focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="Border.sa-field.invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="Border.sa-field-ring">
    <Setter Property="BorderBrush" Value="{DynamicResource ArcFocusOutline}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusPanel}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="TextBlock.sa-placeholder">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
  </Style>
  <Style Selector="Border.sa-chip">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.sa-chip.marked">
    <Setter Property="BorderBrush" Value="{DynamicResource ArcAccent}" />
  </Style>
  <Style Selector="Border.sa-chip.invalid">
    <Setter Property="Background" Value="{DynamicResource ArcDangerSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="TextBlock.sa-chip-label">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="Border.sa-chip.invalid TextBlock.sa-chip-label">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcIcon.sa-error-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="TextBlock.sa-error-text">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcButton.sa-chip-remove">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
  </Style>
  <Style Selector="c|ArcButton.sa-chip-remove:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcBorder}" />
  </Style>
  <Style Selector="c|ArcButton.sa-chip-remove:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="Border.sa-undo">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
  </Style>
  <Style Selector="TextBlock.sa-undo-text">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>
  <Style Selector="Border.sa-divider">
    <Setter Property="Background" Value="{DynamicResource ArcBorderSubtle}" />
  </Style>
  <Style Selector="Border.sa-icon-box">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
  </Style>
  <Style Selector="Border.sa-icon-box.anyone">
    <Setter Property="Background" Value="{DynamicResource ArcAccentSubtle}" />
  </Style>
  <Style Selector="Border.sa-link">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
  </Style>
  <Style Selector="TextBlock.sa-link-text">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>
  <Style Selector="c|ArcButton.sa-role">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>
  <Style Selector="c|ArcButton.sa-role:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.sa-role:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="c|ArcIcon.sa-chevron">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
  </Style>
  <Style Selector="c|ArcButton.sa-remove">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcTextMuted}" />
  </Style>
  <Style Selector="c|ArcButton.sa-remove:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
  <Style Selector="c|ArcButton.sa-remove:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcDangerSubtle}" />
  </Style>
  <Style Selector="Border.sa-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="Border.sa-row.hover">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="Border.sa-avatar">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="TextBlock.sa-avatar-text">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Border.sa-suggest">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ArcRadiusControl}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ArcShadowFloating}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="c|ArcButton.sa-suggest-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="c|ArcButton.sa-suggest-row.active /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="c|ArcButton.sa-suggest-row.active">
    <Setter Property="Foreground" Value="{DynamicResource ArcForeground}" />
  </Style>
  <Style Selector="c|ArcButton.sa-suggest-row:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource ArcSurfaceMuted}" />
  </Style>
  <Style Selector="c|ArcIcon.sa-copy-icon">
    <Setter Property="Foreground" Value="{DynamicResource ArcTextSecondary}" />
  </Style>
  <Style Selector="c|ArcIcon.sa-copy-icon.copied">
    <Setter Property="Foreground" Value="{DynamicResource ArcSuccess}" />
  </Style>
  <Style Selector="c|ArcIcon.sa-copy-icon.failed">
    <Setter Property="Foreground" Value="{DynamicResource ArcDanger}" />
  </Style>
</Styles>
