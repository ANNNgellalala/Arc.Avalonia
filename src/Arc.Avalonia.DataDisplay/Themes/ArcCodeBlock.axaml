<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.DataDisplay.Controls">

  <ControlTheme x:Key="{x:Type c:ArcCodeBlock}" TargetType="c:ArcCodeBlock">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="PART_Host" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
