<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Arc.Avalonia.AgentUI</RootNamespace>
    <AssemblyName>Arc.Avalonia.AgentUI</AssemblyName>
    <PackageId>Arc.Avalonia.AgentUI</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Agent leaf controls for Arc for Avalonia: run control bar, tool approval sheet, background run dock and attention inbox. Conversations, bubbles and the composer live in Arc.Avalonia.Chat and are composed by Arc.Avalonia.Agent.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="..\..\Foundation\Arc.Avalonia\Arc.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arc.Avalonia.Docs" />
  </ItemGroup>
</Project>
