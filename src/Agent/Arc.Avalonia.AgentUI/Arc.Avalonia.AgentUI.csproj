<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Arc.Avalonia.AgentUI</RootNamespace>
    <AssemblyName>Arc.Avalonia.AgentUI</AssemblyName>
    <PackageId>Arc.Avalonia.AgentUI</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Agent transcript, run bar, tool approval sheet, question card, background dock and attention inbox UI contracts for Arc for Avalonia.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="..\..\Foundation\Arc.Avalonia\Arc.Avalonia.csproj" />
    <!-- L4 -> L2: the transcript renders message bodies with the Arc Markdown document view. -->
    <ProjectReference Include="..\..\Components\Arc.Avalonia.Markdown\Arc.Avalonia.Markdown.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arc.Avalonia.Docs" />
  </ItemGroup>
</Project>
