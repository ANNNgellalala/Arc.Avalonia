<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Feedback.Controls"
                    xmlns:shapes="using:Avalonia.Controls.Shapes">

  <ControlTheme x:Key="{x:Type c:ArcAvatar}" TargetType="c:ArcAvatar">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Surface"
                  Width="{TemplateBinding Width}"
                  Height="{TemplateBinding Height}"
                  CornerRadius="{DynamicResource ArcRadiusPill}"
                  ClipToBounds="True">
            <TextBlock x:Name="Initials"
                       FontWeight="Medium"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <shapes:Ellipse x:Name="Dot"
                          Width="10"
                          Height="10"
                          IsVisible="False"
                          StrokeThickness="2"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
