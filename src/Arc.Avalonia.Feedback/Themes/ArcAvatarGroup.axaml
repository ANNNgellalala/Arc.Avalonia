<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Feedback.Controls">

  <ControlTheme x:Key="{x:Type c:ArcAvatarGroup}" TargetType="c:ArcAvatarGroup">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="PART_Host" ClipToBounds="False" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
