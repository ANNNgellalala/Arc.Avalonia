<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Arc.Avalonia.Feedback.Controls">

  <ControlTheme x:Key="{x:Type c:ArcEmptyState}" TargetType="c:ArcEmptyState">
    <Setter Property="FontFamily" Value="{DynamicResource ArcFontBody}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="PART_Host" Margin="24,20" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
